ls":{"width":2500,"height":2500}},"layout":"fill","priority":"high","lazy":false}]}]}],["$","p",null,{"className":"Hero_date__30zpk","children":["$","$L1a",null,{"delay":0.3,"children":["$","span",null,{"children":"November 19th 2024"}]}]}],["$","p",null,{"className":"Hero_name__eLY42","children":["$","$L1a",null,{"delay":0.3,"children":["$","span",null,{"children":["By ","Emily"]}]}]}]]}]}],["$","figure",null,{"className":"Hero_image__1mu0E","children":["$","$L1c",null,{"fill":true,"delay":0.45,"children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/11/interactive-mobile-designs.png 1400w, https://kota-content.b-cdn.net/app/uploads/2024/11/interactive-mobile-designs-500x281.png 500w, https://kota-content.b-cdn.net/app/uploads/2024/11/interactive-mobile-designs-768x432.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/11/interactive-mobile-designs.png","mediaDetails":{"width":1400,"height":787}},"layout":"fill","lazy":false}]}]}],false]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__jY2p_","children":[["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$1e"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/11/6706455cae28b633918647.mp4","layout":"intrinsic"}],["$","div",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://www.awwwards.com/sites/house-of-dreamers\" target=\"_blank\" rel=\"noopener\">Video source</a></p>\n"}}]]}]]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><strong>1. House of Dreamers</strong></h2>\n<p>This promotional site for an immersive exhibition<i> </i>is as dreamy as the name suggests. On desktop, fluid mouse interactions provide an ethereal browsing experience, and on mobile, thumb gestures replicate that fluidity. The immersive soundscapes and visually stunning design translate beautifully across devices, making the mobile version as compelling as its desktop counterpart.</p>\n<h3><strong>What we like:</strong></h3>\n<ul>\n<li><strong>Touch interactivity:</strong> Smooth touch gestures mimic their desktop version&#8217;s fluid effects. And it&#8217;s seriously addictive.</li>\n<li><strong>Immersive sound design:</strong> Their audio elements work seamlessly on mobile, giving a multi-sensory experience.</li>\n<li><strong>Visual aesthetic:</strong> Dreamlike visuals set the tone, reflecting the installations folks can expect to encounter at the exhibition.</li>\n</ul>\n<p><!-- notionvc: 8d092a41-6381-44e1-818f-3b442b90ffd2 --></p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/11/661369eaac753527898272-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/11/661369eaac753527898272-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/11/661369eaac753527898272-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/11/661369eaac753527898272-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/11/661369eaac753527898272.jpg 1600w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/11/661369eaac753527898272.jpg","mediaDetails":{"width":1600,"height":1200}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://www.awwwards.com/sites/hello-period\" target=\"_blank\" rel=\"noopener\">Image source</a></p>\n"}}]]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$20"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/11/66f6b6b9b7250378542041-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/11/66f6b6b9b7250378542041-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/11/66f6b6b9b7250378542041-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/11/66f6b6b9b7250378542041-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/11/66f6b6b9b7250378542041.jpg 1600w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/11/66f6b6b9b7250378542041.jpg","mediaDetails":{"width":1600,"height":1200}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://www.awwwards.com/sites/sonder\" target=\"_blank\" rel=\"noopener\">Image source</a></p>\n"}}]]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><strong>3. Sonder</strong></h2>\n<p>Sonder is another nice example of a vibrant site that carries its playful energy from desktop to mobile. The auto-playing video immediately grabs attention, while micro-animations add a sense of discovery as users scroll. Keeping this mobile version as rich and interactive as the desktop experience really helps build a cohesive brand story across all platforms. The result? A mobile design that feels cohesive, engaging, and distinctly Sonder.</p>\n<h3><strong>What we like:</strong></h3>\n<ul>\n<li><strong>Video integration:</strong> The auto-playing video content draws users in from the get-go.</li>\n<li><strong>On-scroll animations:</strong> The subtle effects guide users, making exploration feel fun and intuitive.</li>\n<li><strong>Cohesive design:</strong> The colourful, vibrant design translates seamlessly across devices, maintaining Sonder&#8217;s brand integrity.</li>\n</ul>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/11/66a12ee7b129a600735462.mp4","layout":"intrinsic"}],["$","div",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://www.awwwards.com/sites/stevia-please-portfolio\" target=\"_blank\" rel=\"noopener\">Video source</a></p>\n"}}]]}]]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><strong>4. Stevia Please</strong></h2>\n<p>The mobile version of Stevia Please&#8217;s portfolio simplifies the desktop design, while still offering unique interactions of its own. A standout feature is the bulging scroll effect, which creates a playful, tactile experience as users move through the homepage. This minimal yet interactive design encourages exploration without overwhelming.</p>\n<h3><strong>What we like:</strong></h3>\n<ul>\n<li><strong>Scroll effects:</strong> The bulging sections create a sense of depth and movement, inviting users to interact.</li>\n<li><strong>Simplified design:</strong> Sometimes less is more—streamlining interactions for mobile ensures the experience remains fun to use, without sacrificing functionality.</li>\n<li><strong>Encourages discovery:</strong> The layout and effects guide users naturally through the content.</li>\n</ul>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/11/66cf46a95c622158900232-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/11/66cf46a95c622158900232-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/11/66cf46a95c622158900232-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/11/66cf46a95c622158900232-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/11/66cf46a95c622158900232.jpg 1600w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/11/66cf46a95c622158900232.jpg","mediaDetails":{"width":1600,"height":1200}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWid