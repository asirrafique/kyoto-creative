en":["By ","James Piper"]}]}]}]]}]}],["$","figure",null,{"className":"Hero_image__1mu0E","children":["$","$L1c",null,{"fill":true,"delay":0.45,"children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/blog-header-1400x748.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/blog-header-500x267.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/blog-header-768x410.webp 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/blog-header-1536x821.webp 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/blog-header.webp 1928w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/blog-header.webp","mediaDetails":{"width":1928,"height":1030}},"layout":"fill","lazy":false}]}]}],false]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__jY2p_","children":[["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$1e"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/research-1400x1114.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/research-500x398.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/research-768x611.webp 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/research-1536x1222.webp 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/research.webp 1538w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/research.webp","mediaDetails":{"width":1538,"height":1224}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>Nicola, our talented Digital Designer, had the first light bulb moment – “We’ve gotta call it the KOTAverse right?!”</p>\n<p>BINGO! …The KOTAverse was officially born. Now onto the design.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/kv-title-1400x831.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/kv-title-500x297.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/kv-title-768x456.webp 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/kv-title.webp 1536w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/kv-title.webp","mediaDetails":{"width":1536,"height":912}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Designing the timeline</h2>\n<p>Visualising what the KOTAverse could look like was our next challenge. We embraced the spacey, futuristic vibe that the name brings to mind, and in our research phase, stumbled upon a couple of incredibly cool things.</p>\n<p>Firstly the <a href=\"https://blobmixer.14islands.com/\">Blob Mixer</a>, an interactive WebGL componant. As we’ve already got a soft spot for blended gradients as part of the KOTA brand, we thought this would be perfect as the blob’s material. It looks futuristic ✅, uses cutting-edge technology ✅, and is interactive ✅!</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/02/blob-mixer.mp4","layout":"intrinsic"}],null]}]]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/gradient-blob-1400x700.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/gradient-blob-500x250.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/gradient-blob-768x384.webp 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/gradient-blob.webp 1536w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/gradient-blob.webp","mediaDetails":{"width":1536,"height":768}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>The second cool thing we found was the portfolio of <a href=\"https://cydstumpel.nl/\">Cyd Stumpel</a>, an extremely talented creative Web Developer based in the Netherlands (more about Cyd later).</p>\n<p>We loved how she presents her work on the homepage using a rotating 3D carousel and it got us thinking of how to present our history.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/02/cyd-timeline.mp4","layout":"intrinsic"}],null]}]]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>So with this and the blob in mind, we started to experiment using After Effects. The concept is centered around an interactive journey through history; as users scroll, they’ll see a dynamic visual timeline, with events orbiting around a central blob. Each event can be clicked on, inviting users to delve deeper and explore more about each significant moment.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/02/kv1.mp4","layout":"intrinsic"}],["$","div",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p>Early demo</p>\n"}}]]}]]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>Once we were all happy with this concept, we gave the design a bit of polish.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/02/kv2.mp4","layout":"intrinsic"}],null]}]]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Going deeper</h2>\n<p>For the ‘Who We Are Now’ section, we quickly knew that it would be contained within the KOTAverse orb (our signature blob). Here, users are enticed with the option to click into the orb to ‘Go Deeper,’ a feature that transports them inside, offering an immersive, in-depth exploration of our current identity and ethos.</p>\n<p>We then came up with 5 content types we feel make us who we are now, we’re most proud of and were interesting to share.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/what-make-us-1400x831.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/what-make-us-500x297.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/what-make-us-768x456.webp 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/what-make-us.webp 1536w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/what-make-us.webp","mediaDetails":{"width":1536,"height":912}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>The fifth Element</h2>\n<p>After we decided on the content, Margo (another very talented member of the design team) blew all our minds. Her idea was that the five content types were actually ‘elements’ with the Fifth element – Our team, being the most important.</p>\n<p>To tie things in with the orb, each element would be represented by a 3D shape using our brand colours.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/5-elements-1400x831.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-elements-500x297.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-elements-768x456.webp 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-elements.webp 1536w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/5-elements.webp","mediaDetails":{"width":1536,"height":912}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>Now that we had the five elements confirmed, we started to think about how this area of the site would function. We really liked the concept of an innerspace, inside the KOTAverse, where you could drag around exploring these elements infinity (until you got bored of course).</p>\n<p>Nicola had a fun idea that the team were on Top Trump cards, so we decided to use this format for all the other elements.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/02/card-flip.mp4","layout":"intrinsic"}],null]}]]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/cards-1400x831.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/cards-500x297.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/cards-768x456.webp 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/cards.webp 1536w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/cards.webp","mediaDetails":{"width":1536,"height":912}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>We also used AI and <a href=\"https://www.neuralframes.com/\">Neuralframes</a> to create some pretty cool avatars of ourselves.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/02/team-1.mp4","layout":"intrinsic"}],null]}]]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/02/kv-scroll2-compressed.mp4","layout":"intrinsic"}],["$","div",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p>Going deeper</p>\n"}}]]}]]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Development</h2>\n<p>You might remember Cyd, who’s website inspired our timeline idea. Well, half way through the design concepts we contacted her about developing the site for us …and she said yes!</p>\n<p>Here’s a bit from Cyd about the technical aspects of the build and what makes it unique :</p>\n<p>The timeline was built using <a href=\"https://threejs.org/docs/\">Three.js</a>, a library to create intricate 3D worlds. In ‘conventional’ web development, a developer adds HTML elements to the page that have default behaviours; for example an HTML button element is clickable and has a focus state.</p>\n<p>Experiences created with Three.js do not consist of HTML elements, every pixel that is displayed on the screen is calculated on a canvas element. To make elements interactive you have to calculate if the mouse is overlaying a certain pixel, or use other tricks to make it feel like any other UX pattern that a user is used to.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/02/blob.mp4","layout":"intrinsic"}],null]}]]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$20"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/02/kv-full-compressed.mp4","layout":"intrinsic"}],null]}]]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$21"}}]}]}]}]}]]}],["$","$L22",null,{}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"BlogPost_buttonOuter__M9Wmd","children":["$","$L1a",null,{"children":["$","$L11",null,{"type":"a-internal","href":"/blog","text":"Back to blog","direction":"backwards"}]}]}]}],["$","section",null,{"className":"RelatedPosts_relatedPosts__xfLkb","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"RelatedPosts_headingOuter__r3TEg","children":[["$","p",null,{"className":"RelatedPosts_heading__3kOeH","children":["$","$L1d",null,{"children":"Related Articles"}]}],["$","div",null,{"classNa