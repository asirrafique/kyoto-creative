"height":1370}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$1f"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/features-1-1400x1142.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/features-1-2000x1632.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/features-1-500x408.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/features-1-768x627.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/features-1-1536x1253.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/features-1-2048x1671.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/features-1.jpg","mediaDetails":{"width":2500,"height":2040}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><span style=\"font-weight: 400;\">Just a Splash.</span></h2>\n<p><span style=\"font-weight: 400;\">Similar to the smaller font size principle above, the same applies to colour. Traditionally luxury brands opt for a black and white colour palette or darker shades of a brand colour. However this isn’t a golden rule and colour can still be premium if used sparingly, with a minimal colour palette or an accent colour to support darker tones, but probably best to steer clear of the neon!</span></p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/intro2-1400x885.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/intro2-2000x1264.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/intro2-500x316.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/intro2-768x485.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/intro2-1536x971.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/intro2-2048x1294.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/intro2.jpg","mediaDetails":{"width":2361,"height":1492}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><span style=\"font-weight: 400;\">Minimal is Key.</span></h2>\n<p><span style=\"font-weight: 400;\">The reason design looks premium is often because it is minimal and elegant. Keeping things simple in terms of design elements, creates awe of luxury. Cluttered, heavy, layered design, although very effective in certain environments, will not achieve a premium look.</span></p>\n<p>&nbsp;</p>\n<h2><span style=\"font-weight: 400;\">White Space.</span></h2>\n<p><span style=\"font-weight: 400;\">Utilising ‘white space’ effectively (space with no design elements in) will help the content breathe and focus in on the beautifully designed elements. Giving elements enough room is more pleasing to the eye and helps maintain the minimal and premium look. Look to use layout grids to create order within the space. </span></p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/web-development-1-1400x1020.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/web-development-1-500x364.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/web-development-1-768x559.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/web-development-1-1536x1119.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/web-development-1.jpg 2000w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/web-development-1.jpg","mediaDetails":{"width":2000,"height":1457}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><span style=\"font-weight: 400;\">Refined Wordmark.</span></h2>\n<p><span style=\"font-weight: 400;\">When creating a logo, often luxury brands opt for a ‘wordmark’ that is essentially an elegant font set beautifully with potentially a supporting icon. Working into the font to create distinct shapes or concepts is usually steered away from, as the font and its type set do itself become the logo. A branding example of creating an elegant word with a supporting icon can be seen here for </span><a href=\"https://kota.co.uk/work/understanding-jewellery\"><span style=\"font-weight: 400;\">Understanding Jewellery</span></a><span style=\"font-weight: 400;\">.</span></p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/1.-Main-Screen-1400x821.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/1.-Main-Screen-2000x1173.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/1.-Main-Screen-500x293.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/1.-Main-Screen-768x450.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/1.-Main-Screen-1536x901.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/1.-Main-Screen-2048x1201.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/1.-Main-Screen.jpg","mediaDetails":{"width":2302,"height":1350}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$20"}}]}]}]}]}],["$","section",null,{"className":"TwoMediaGrid_twoMediaGrid__N4mxT","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TwoMediaGrid_left__e0Ka_","children":["$","$L1a",null,{"children":[["$","figure",null,{"className":"$undefined","data-width":"$undefined","children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study-4-1400x813.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study-4-2000x1161.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study-4-500x290.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study-4-768x446.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study-4-1536x892.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study-4-2048x1189.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study-4.jpg","mediaDetails":{"width":2360,"height":1370}},"layout":"intrinsic"}]}],false]}]}],["$","div",null,{"className":"TwoMediaGrid_right__cnLmS","children":["$","$L1a",null,{"delay":0.15,"children":[["$","figure",null,{"className":"$undefined","data-width":"$undefined","children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/mobile-2-1400x758.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/mobile-2-2000x1082.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/mobile-2-500x271.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/mobile-2-768x416.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/mobile-2-1536x831.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/mobile-2-2048x1108.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/mobile-2.jpg","mediaDetails":{"width":2500,"height":1353}},"layout":"intrinsic"}]}],false]}]}]]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Conclusions.</h2>\n<p>When designing for clients in the luxury sector we always think about the message we&#8217;d like our work to convey &#8211; after all, it&#8217;s not only about the product or service, it&#8217;s about buying into the brand itself. The design has to speak to customers on a personal level and highlight the exclusivity of the offering.</p>\n<p>Opting for elegant minimalism is the best approach, yet steer away from appearing too basic. Premium brand design doesn&#8217;t have to be boring!</p>\n<p>If you&#8217;re looking for a luxury brand design agency, don&#8217;t hesitate to get in touch with our team. We&#8217;ll guide you every step of the way to ensure your brand appeals to your target market.</p>\n"}}]}]}]}]}]]}],["$","$L21",null,{}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"BlogPost_buttonOuter__M9Wmd","children":["$","$L1a",null,{"children":["$","$L11",null,{"type":"a-internal","href":"/blog","text":"Back to blog","direction":"backwards"}]}]}]}],["$","section",null,{"className":"RelatedPosts_relatedPosts__xfLkb","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"RelatedPosts_headingOuter__r3TEg","children":[["$","p",null,{"className":"RelatedPosts_heading__3kOeH","children":["$","$L1d",null,{"children":"Related Articles"}]}],["$","div",null,{"className":"RelatedPosts_viewAllLinkDesktop__db363","children":["$","$L1d",null,{"delay":0.15,"children":["$","$L11",null,{"type":"a-internal","text":"View all articles","color":"white","href":"/blog"}]}]}]]}]}],["$","$L22",null,{"children":["$","div",null,{"className":"container","children":[["$","$L14","2161",{"className":"BlogPostCard_post__fNGbL BlogPostCard_small__j18h2","href":"/blog/how-to-build-successful-brands","data-animation":"grid-item","children":[["$","div",null,{"className":"BlogPostCard_postImage__Q4k_I","children":[["$","div",null,{"className":"BlogPostCard_tags__RKboe","children":[false,[["$","span","Expertise",{"className":"BlogPostCard_tag__Dv5HS","children":"Expertise"}],["$","span","Our work",{"className":"BlogPostCard_tag__Dv5HS","children":"Our work"}]]]}],["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/header-1-1400x748.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/header-1-2000x1068.webp 2000w, https://ko