.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/2-6-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/2-6.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/3-7.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2024/02/3-7-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2024/02/3-7-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/3-7.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/4-7.jpg 1190w, https://kota-content.b-cdn.net/app/uploads/2024/02/4-7-432x500.jpg 432w, https://kota-content.b-cdn.net/app/uploads/2024/02/4-7-768x889.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/4-7.jpg","mediaDetails":{"width":1190,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media4__biNHW","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/5-5-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-5-2000x1126.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-5-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-5-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-5-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-5-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/5-5.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Website.</h2>\n<p>Their website needed to act as both a marketing tool and as a functional jobs board allowing candidates to manage their CVs and apply for jobs with ease.</p>\n<p>We created a large array of components with alternating colours and bold graphic elements. The bespoke visual page builder allows the client to easily add content via the backend. This was essential for their ever-changing marketing needs in such a competitive industry.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/6-4-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/6-4-2000x1126.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/6-4-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/6-4-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/6-4-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/6-4-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/6-4.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/7-5.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2024/02/7-5-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2024/02/7-5-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/7-5.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/8-5.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2024/02/8-5-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2024/02/8-5-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/8-5.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Branding.</h2>\n<p>We created a bespoke block letter icon signifying the building blocks of a career. Alongside the block forms, we utilised colour-coded elements to signpost jobs and sections both across the website and in presentations, so every department at BMS felt like they owned a bit of the new brand.</p>\n<p>Their new super modern brand typeface now stands out from their competitors and allows them to have distinct type-led communications.</p>\n<p>We also established a flexible graphic system for generating all their website imagery utilising bold colours, branded shapes and stock imagery. Now, those elements can be easily replicated and built on in the future without the need for expensive photoshoots.</p>\n<p>&nbsp;</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"SingleImage_singleImage__NY3zv","data-margin":"default","children":["$","$L21",null,{"children":[false,["$","div",null,{"className":"SingleImage_fullWidthImage__nPNe8","children":["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/9-4-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/9-4-2000x1125.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/9-4-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/9-4-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/9-4-1536x864.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/9-4-2048x1152.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/9-4-2560x1440.jpg","mediaDetails":{"width":2560,"height":1440}}}]}]]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout6__wJx6J","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/10-8-1400x777.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/10-8-2000x1109.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/10-8-500x277.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/10-8-768x426.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/10-8-1536x852.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/10-8-2048x1136.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/u