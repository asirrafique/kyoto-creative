/uploads/2026/07/brands-that-commit-to-the-bit-1400x788.png 1400w, https://kota-content.b-cdn.net/app/uploads/2026/07/brands-that-commit-to-the-bit-2000x1125.png 2000w, https://kota-content.b-cdn.net/app/uploads/2026/07/brands-that-commit-to-the-bit-500x281.png 500w, https://kota-content.b-cdn.net/app/uploads/2026/07/brands-that-commit-to-the-bit-768x432.png 768w, https://kota-content.b-cdn.net/app/uploads/2026/07/brands-that-commit-to-the-bit-1536x864.png 1536w, https://kota-content.b-cdn.net/app/uploads/2026/07/brands-that-commit-to-the-bit-2048x1152.png 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/07/brands-that-commit-to-the-bit.png","mediaDetails":{"width":2240,"height":1260}},"layout":"fill","lazy":false}]}]}],false]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__jY2p_","children":[["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p class=\"isSelectedEnd\">Most brands can make a nice logo. Fewer can build a world people want to step into, talk about and spend money in.</p>\n<p class=\"isSelectedEnd\">A polished visual identity might win you a second look. But a clear, committed brand idea gives people a reason to remember you once they’ve scrolled on.</p>\n<p class=\"isSelectedEnd\">The brands below work because they don’t treat branding as the layer that sits on top of the business. Their point of view runs through the product, packaging, language, content, customer experience, and the decisions they make when nobody&#8217;s looking.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width"