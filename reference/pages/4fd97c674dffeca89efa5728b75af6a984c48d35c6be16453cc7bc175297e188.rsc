",null,{"fill":true,"delay":0.45,"children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/notion-x-kota-1-1400x781.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/notion-x-kota-1-2000x1116.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/notion-x-kota-1-500x279.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/notion-x-kota-1-768x428.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/notion-x-kota-1-1536x857.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/notion-x-kota-1-2048x1142.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/notion-x-kota-1.jpg","mediaDetails":{"width":2239,"height":1249}},"layout":"fill","lazy":false}]}]}],false]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__jY2p_","children":[["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$1e"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/1.png 1079w, https://kota-content.b-cdn.net/app/uploads/2024/02/1-500x222.png 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/1-768x340.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/1.png","mediaDetails":{"width":1079,"height":478}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2></h2>\n<h2><b>2. Task boards &amp; timelines.</b></h2>\n<p><span style=\"font-weight: 400;\">We now utilise relational databases throughout our Notion space so everything is automated and easy for the team to use &#8211; we particularly love a task board. Each task is linked to a project, a client, a team member, etc so whichever filter you apply, the view is clear. It also means each step in the process is plotted clearly for internal use and for the clients use in the form of a timeline to allow for a transparent working environment. Notion doesn’t allow for a dependent timeline just yet so until then, it’s manually updated!</span></p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"TwoMediaGrid_twoMediaGrid__N4mxT","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TwoMediaGrid_left__e0Ka_","children":["$","$L1a",null,{"children":[["$","figure",null,{"className":"$undefined","data-width":"$undefined","children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2021-10-01-at-10.55.01-1400x682.png 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2021-10-01-at-10.55.01-2000x974.png 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2021-10-01-at-10.55.01-500x244.png 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2021-10-01-at-10.55.01-768x374.png 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2021-10-01-at-10.55.01-1536x748.png 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2021-10-01-at-10.55.01.png 2024w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2021-10-01-at-10.55.01.png","mediaDetails":{"width":2024,"height":986}},"layout":"intrinsic"}]}],false]}]}],["$","div",null,{"className