20:["$","section",null,{"className":"Intro_intro__B7xXJ","children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"$undefined","children":["$","$L1a",null,{"children":["$","span",null,{"children":"Growth built around your brand."}]}]}],["$","div",null,{"className":"Intro_text__4DPtt prose","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">A strong brand and website gives you the platform. Growth marketing helps it keep earning attention. We provide packages that connect visibility, content and ongoing website support. From SEO and GEO to copywriting and technical support, we help your brand stay active, findable and ready for what’s next.</span></p>\n"}}]}]}]]}]}]
21:["$","section",null,{"className":"TextImageRows_textImageRows__lOU02","children":["$","div",null,{"className":"container","children":[[["$","div","0",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"SEO & GEO."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Search is changing fast. We help brands improve visibility across AI search, LLMs and generative engine results through structured content, stronger authority signals, technical foundations and ongoing optimisation.</p>\n"}}]}]}],["$","div",null,{"className":"TextImageRows_buttonContainer___PqVy","children":["$","$L1c",null,{"delay":0.3,"children":["$","$L11",null,{"href":"/service/seo-geo","type":"a-internal","text":"Find out more"}]}]}]]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L2e",null,{"fill":true,"children":[false,["$","$L2f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2023/11/seo-geo-V2.mp4","layout":"fill"}]]}]}]]}],["$","div","1",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":" Copywriting."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>We write the words that make the work land. From content audits and strategy to ongoing copywriting support, we help brands explain themselves properly, make a stronger case and show up with something worth saying.</p>\n"}}