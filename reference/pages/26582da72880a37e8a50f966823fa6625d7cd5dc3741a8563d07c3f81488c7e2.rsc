","href":"/work"}]}]}]]}],["$","section",null,{"className":"FaqsList_faqsList__W3Ud0","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":[["$","div",null,{"className":"FaqsList_heading__kNT8k","children":["$","p",null,{"children":["$","$L2a",null,{"children":"FAQ's"}]}]}],[["$","div","0",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2a",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What is growth marketing at KOTA?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Growth marketing at KOTA includes a series of ongoing support packages designed to help your website keep performing after launch. It can include AI and GEO support, SEO content, copywriting, technical optimisation, reporting and SiteCare.</span></p>\n<p><span style=\"font-weight: 400;\">The aim is to improve visibility, strengthen content and keep your website healthy, useful and aligned with the brand as your business evolves.</span></p>\n"}}]}]]}]}],["$","div","1",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2a",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What is AI search and GEO?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">AI and GEO stands for artificial intelligence and generative engine optimisation. It focuses on helping your brand become easier for AI search tools, LLMs and generative search engines to understand and reference.</span></p>\n<p><span style=\"font-weight: 400;\">Currently, that includes clear website structure, useful content, strong authority signals, FAQs, entity-led optimisation and technical foundations that support visibility beyond traditional search results. But it&#8217;s always changing, so we&#8217;ll help you keep up. </span></p>\n"}}]}]]}]}],["$","div","2",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2a",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Do you offer ongoing SEO support?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">We do! Our ongoing support can include SEO strategy, blog planning, content writing, metadata, technical recommendations, internal linking and performance reporting. </span></p>\n<p><span style=\"font-weight: 400;\">We focus on creating useful, brand-led content that helps people and search engines understand your expertise, rather than producing filler blogs for the sake of activity.</span></p>\n"}}]}]]}]}],["$","div","3",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2a",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Do you write copy for websites?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yep, our team includes copywriters and content strategists with over 10+ years of experience. We </span><span style=\"font-weight: 400;\">offer website copywriting as a crucial service for websites we design and build. This helps the strategy, design and content work together properly, so pages feel clear, consistent and built around the same brand idea.</span></p>\n"}}]}]]}]}],["$","div","4",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2a",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Do you write blog content?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Absolutely. Blog writing is available as part of our ongoing SEO support packages. We can plan and write search-led articles that support visibility, answer audience questions and build topical authority over time.</span></p>\n"}}]}]]}]}],["$","div","5",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2a",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What is SiteCare?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">SiteCare is our ongoing website support and growth retainer. It keeps your website secure, stable and properly maintained after launch, with support for updates, monitoring, fixes, hosting, performance and agreed improvements.</span></p>\n<p><span style=\"font-weight: 400;\">It gives your team a reliable partner for the technical side of the website, rather than leaving everything to pile up until something breaks.</span></p>\n"}}]}]]}]}],["$","div","6",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2a",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Do we need to have built our website with KOTA to use these services?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Not always, but it depends on the service and the condition of the website. SiteCare is strongest when we already understand the build, but we can review existing websites and advise whether ongoing support is suitable.</span></p>\n<p><span style=\"font-weight: 400;\">For copywriting and AI/GEO support, we can usually work with your existing site, although we may recommend technical or structural improvements first.</span></p>\n"}}]}]]}]}],["$","div","7",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2a",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"How do you measure growth marketing success?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Success depends on the goals of the project, but we usually look at visibility, rankings, organic traffic, AI search presence, engagement, conversions, content performance and website health. We will agree KPIs based on your goals.</span></p>\n<p><span style=\"font-weight: 400;\">We also look for the less flashy but important signs: clearer messaging, stronger content, fewer technical issues and a website that supports the business more effectively over time.</span></p>\n"}}]}]]}]}]]]}]]}],"$L2c","$L2d"]}]]
