","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/10/Font.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2025/10/Font-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2025/10/Font-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/10/Font.jpg","mediaDetails":{"width":1188,"height":1379}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media4__biNHW","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/10/Truck.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2025/10/Truck-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2025/10/Truck-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/10/Truck.jpg","mediaDetails":{"width":1188,"height":1379}},"layout":"intrinsic"}],false]}],false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>The challenge</h2>\n<p>The old site lacked finesse and structure. It didn’t tell the story of GSC’s expertise or their ethos that “sustainability is in our DNA.” Design felt inconsistent, and the user experience left investors underwhelmed.</p>\n<p>As GSC grew into a multi-fund platform, they needed more than a new coat of paint. They needed a <strong>brand ecosystem and digital presence that proved their global credentials in sustainable investment</strong> — and gave them space to expand.</p>\n<p><!-- notionvc: a5f1b729-281b-4af9-8d7c-eced55df1ba9 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"SingleImage_singleImage__NY3zv",