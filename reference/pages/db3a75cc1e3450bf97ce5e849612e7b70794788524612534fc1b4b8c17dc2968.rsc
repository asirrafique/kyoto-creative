ent.b-cdn.net/app/uploads/2025/10/Large-Logo-1536x864.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2025/10/Large-Logo-2048x1152.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/10/Large-Logo.jpg","mediaDetails":{"width":2454,"height":1380}},"lazy":false,"priority":"high","sizes":"100vw"}],false]}]}]]}],["$","section",null,{"className":"Intro_intro__kvY3Y","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Intro_text__1JkoM","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>Gore Street Capital (GSC) have been ahead of the curve since 2016, when they acquired their first battery energy storage system. Two years later, they launched the world’s first listed energy storage fund on the London Stock Exchange.</p>\n<p>Today, they manage assets across five international markets — a global team powering the transition to a low-carbon economy.</p>\n<p>The only catch? Their brand and website didn’t keep up. Outdated, uninspiring, and short on credibility, they no longer reflected the company GSC had become — or the sustainable future they’re building.</p>\n<p><!-- notionvc: cf7b1d03-d4d9-4fe9-a38b-3d44e383b546 --></p>\n"}}]}]}],["$","div",null,{"className":"Intro_projectDetails__UWcsm","children":[["$","div",null,{"className":"Intro_left__d8bha","children":["$","$L1d",null,{"delay":0.15,"children":[["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Industry"}],["$","p",null,{"children":"Renewable energy "}]]}],["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Location"}],["$","p",null,{"children":"Global"}]]}]]}]}],["$","div",null,{"className":"Intro_right__E3UWy","children":["$","$L1d",null,{"delay":0.15,"children":null}]}]]}],["$","div",null,{"className":"Intro_link__Wrq2r","children":["$","$L1d",