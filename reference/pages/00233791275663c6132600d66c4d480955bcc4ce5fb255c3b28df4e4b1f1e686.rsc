Mw==",{"className":"Hero_service__YURmU","children":"Brand strategy"}],["$","div","dGVybTo1MQ==",{"className":"Hero_service__YURmU","children":"Tone of voice"}],["$","div","dGVybTo1Mg==",{"className":"Hero_service__YURmU","children":"Brand identity"}]]}]}]}],["$","div",null,{"className":"Hero_arrow__KkhoQ","children":["$","$L1e",null,{"delay":0.9,"children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 75.91 75.65","children":["$","path",null,{"d":"m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z"}]}]}]}]]}]]}]}],["$","section",null,{"className":"Bento_bento__pskN5","children":[false,false,["$","div",null,{"className":"container","children":["$","div",null,{"className":"Bento_contained__4KAWy","children":[false,["$","$L1f",null,{"src":"/Homepage-Hero-Loop.mp4","poster":"/seven-gate-hero-preview.png"}]]}]}]]}],["$","section",null,{"className":"Intro_intro__kvY3Y","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Intro_text__1JkoM","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>Bucher + Suter helps enterprise organisations get more from their contact centre platforms. They connect systems, improve performance and help CX teams make technology work harder for people, teams and customers.</p>\n<p>The expertise was always there. The challenge was helping people see it faster.</p>\n<p>B+S works in a category full of technical language, platform noise and plenty of AI chat. Their brand had depth, but the story had become harder to follow. The identity wasn’t always easy to apply consistently, and the website made visitors work a bit too hard to find the good stuff.</p>\n<p>Before touching the logo, colours or website, we started with strategy.</p>\n<p><!-- notionvc: c920145b-f154-4457-820d-2f9dfb5fc5c8 --></p>\n"}}]}]}],["$","div",null,{"className":"Intro_projectDetails__UWcsm","children":[["$","div",null,{"className":"Intro_left__d8bha","children":["$","$L1d",null,{"delay":0.15,"children":[["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Industry"}],["$","p",null,{"children":"SaaS"}]]}],["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Location"}],["$","p",null,{"children":"London, UK"}]]}]]}]}],["$","div",null,{"className":"Intro_right__E3UWy","children":["$","$L1d",null,{"delay":0.15,"children":null}]}]]}],["$","div",null,{"className":"Intro_link__Wrq2r","children":["$","$L1d",null,{"delay":0.3,"children":["$","a",null,{"href":"https://www.bucher-suter.com/","target":"_blank","style":{"backgroundColor":"#b8c8ff","borderColor":"#b8c8ff"},"children":[["$","span",null,{"className":"$undefined","children":"Visit site"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 12.6 12.6","className":"Intro_buttonArrow___9UE0","children":[["$","path",null,{"fill":"#fff","d":"M11.85 12.6c-.41 0-.75-.34-.75-.75V1.5H.75C.34 1.5 0 1.16 0 .75S.34 0 .75 0h11.1c.41 0 .75.34.75.75v11.1c0 .41-.34.75-.75.75z"}],["$","path",null,{"fill":"#fff","d":"M1.13 12.21c-.19 0-.38-.07-.53-.22a.754.754 0 010-1.06L11.32.22c.29-.29.77-.29 1.06 0 .29.29.29.77 0 1.06L1.66 11.99c-.15.15-.34.22-.53.22z"}]]}]]}]}]}]]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__FAKQG","children":[["$","section",null,{"className":"SingleImage_singleImage__NY3zv","data-margin":"default","children":["$","$L20",null,{"children":[["$","div",null,{"className":"container","children":["$","div",null,{"className":"SingleImage_containedImage__N2jLD","children":["$","$L1c",null,{"image":{"altText":"Logo for Bucher + Suter brand by KOTA","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/BeforeAfter-Logo-1400x788.png 1400w, /seven-gate-before-after.png 2000w, https://kota-content.b-cdn.net/app/uploads/2026/06/BeforeAfter-Logo-500x281.png 500w, https://kota-content.b-cdn.net/app/uploads/2026/06/BeforeAfter-Logo-768x432.png 768w, https://kota-content.b-cdn.net/app/uploads/2026/06/BeforeAfter-Logo-1536x865.png 1536w, https://kota-content.b-cdn.net/app/uploads/2026/06/BeforeAfter-Logo-2048x1153.png 2048w","sourceUrl":"/seven-gate-before-after.png","mediaDetails":{"width":2448,"height":1378}}}]}]}],false]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>The strategy</h2>\n<p>We built the strategy around one clear idea: <em>Bucher + Suter makes the whole contact centre system perform as one, then keeps it performing over time.</em></p>\n<p>That moved the story away from long lists of technical capabilities and towards the problems customers actually recognise: disconnected systems, underused platforms, stretched teams, complex environments and pressure to make AI genuinely useful.</p>\n<p>Five strategic pillars became the foundation:</p>\n<ul>\n<li>Connect the whole contact centre system</li>\n<li>Own performance beyond launch</li>\n<li>Proven in complex environments</li>\n<li>Make your platform investment pay off</li>\n<li>Make AI work for people</li>\n</ul>\n<p>They gave the team a practical filter for every decision. If something didn’t make the value clearer or speak to the customer’s reality, it didn’t make the cut.</p>\n<p><!-- notionvc: 19156ade-2704-48fe-a4bf-218bc2407ac1 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout2__oUjwC","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/06/Icon-Construction.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/Logo-Suite.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/06/Logo-Suite-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/06/Logo-Suite-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/Logo-Suite.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/06/Logo-Construction.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>The audience</h2>\n<p>B+S customers are expected to improve service, prove ROI and keep critical platforms performing, all while managing live systems, sensitive data, internal pressure and limited resources. It&#8217;s a lot of complexity to deal with, so they need a partner who understands the operational reality behind the technology.</p>\n<p>That shaped the brand from the start: calm, direct, technically credible and focused on making complexity feel manageable.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout4__cFAXt","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"Typography Bucher + Suter brand by KOTA","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/Font-1.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/06/Font-1-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/06/Font-1-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/Font-1.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"Colours for Bucher + Suter brand by KOTA","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/Colours.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/06/Colours-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/06/Colours-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/Colours.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],false,false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Simplifying the identity</h2>\n<p>The original logo had recognition, but the abbreviated Bucher + Suter styling made the full name harder to read, say and remember. A full rebrand would’ve been overkill, so we refined what was already working.</p>\n<p>We brought Bucher + Suter to the front and created a separate icon for compact digital spaces, from social profiles to favicons. The result improved recognition while protecting the brand equity they’d already built.</p>\n<p><!-- notionvc: 1c058cfc-3f65-4daa-bda8-0ed2b31f1064 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/06/Wave-Compilation.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/06/Wave-Front.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/Frame-1.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/06/Frame-1-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/06/Frame-1-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/Frame-1.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Turning integration into a visual story</h2>\n<p>B+S connects fragmented tools, platforms and processes into a smoother system. We needed to show that without defaulting to dense diagrams or generic tech visuals. So we created the wave.</p>\n<p>Built from contact centre components flowing together, it turned the strategic idea of whole-system performance into something people could understand at a glance. It now flexes across hero sections, CTAs, backgrounds and marketing materials.</p>\n<p>Rather than creating loads of disconnected visual assets, B+S had one distinctive device that could carry the story across the brand.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"$undefined","data-margin":"default","children":[["$","div",null,{"className":"container","children":["$","div",null,{"className":"SingleImage_containedImage__N2jLD","children":["$","$L22",null,{"data":{"__typename":"Project_Singleproject_ContentBuilder_SingleVideo","fieldGroupName":"Project_Singleproject_ContentBuilder_SingleVideo","alignment":"contained","marginBottom":"default","loop":{"mediaItemUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/Overview-Hero-Loop.mp4"},"fullVideo":null}}]}]}],false]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Creating a colour system with control</h2>\n<p>Bucher + Suter already had a colourful world, but the existing gradients needed more discipline. So we introduced a cleaner palette with a minimal base, and a refined rainbow gradient drawn from the original brand colours. This gave the team more flexibility without losing consistency.</p>\n<p>The result feels sharper and more distinctive, with enough warmth to stand apart from the sea of enterprise-tech blue.</p>\n<p><!-- notionvc: f7e24d78-ea2c-4501-b916-a8c40f625895 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout4__cFAXt","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/Example-1.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/06/Example-1-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/06/Example-1-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/Example-1.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/Example-2.png 891w, https://kota-content.b-cdn.net/app/uploads/2026/06/Example-2-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/06/Example-2-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/Example-2.png","mediaDetails":{"width":891,"height":1034}},"layout":"intrinsic"}],false]}],false,false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Building the website around customer problems</h2>\n<p>We rebuilt the site structure around the five strategic pillars, creating clearer routes through the site. That means a CX leader can quickly find the value in improving platform performance, technical stakeholders can still get to the detail they need, and  teams exploring AI can understand Bucher + Suter’s practical approach without being hit with hype.</p>\n<p>Every page had a job. Instead of asking, “What do we need to say about this service?”, we asked, “What problem is this helping the customer solve?” Small shift. Big difference.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/06/Dashboard.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/06/PieChart-V2.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/06/BarChart.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Brand-to-build</h2>\n<p>The website uses a clean digital interface with controlled moments of colour, gradient, shadow and motion. A Spline-built wave animation brings energy to key moments, including the homepage and CTAs, while reinforcing the idea of connected systems.</p>\n<p>Every design choice had to earn its place. The site needed to feel on-brand, modern and distinctive, without adding more noise.</p>\n<p><!-- notionvc: a952e94e-30e2-4325-bf2f-38ce993a9c41 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/06/Web-Desktop-Compilation.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/Website-2.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/06/Website-2-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/06/Website-2-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/Website-2.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/Website-1.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/06/Website-1-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/06/Website-1-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/Website-1.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Giving the brand a steadier voice</h2>\n<p>Bucher + Suter has deep expertise, but it wasn’t always expressed consistently. So we developed a tone of voice that reflects what makes the business valuable: connecting complex systems, taking ownership beyond implementation and bringing a practical, people-focused approach to AI.</p>\n<p>The new voice is measured, useful and confident. It explains technical complexity without hiding behind jargon, and leads with outcomes rather than features.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout4__cFAXt","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/06/Document.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/06/Presentation.mp4","layout":"intrinsic"}]]}],false,false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Making consistency easier</h2>\n<p>A brand only works when people can actually use it, so we created a custom-built online brand platform, giving the Bucher + Suter team one place to access guidelines, assets and usage rules. This makes the system easier to apply across sales, marketing, internal comms and future content.</p>\n<p><!-- notionvc: dd6b96f6-4972-4963-80f0-76577a3764aa --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"SingleImage_singleImage__NY3zv","data-margin":"default","children":["$","$L20",null,{"children":[["$","div",null,{"className":"container","children":["$","div",null,{"className":"SingleImage_containedImage__N2jLD","children":["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/Socials-1400x788.png 1400w, https://kota-content.b-cdn.net/app/uploads/2026/06/Socials-500x282.png 500w, https://kota-content.b-cdn.net/app/uploads/2026/06/Socials-768x433.png 768w, https://kota-content.b-cdn.net/app/uploads/2026/06/Socials-1536x865.png 1536w, https://kota-content.b-cdn.net/app/uploads/2026/06/Socials.png 1836w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/Socials.png","mediaDetails":{"width":1836,"height":1034}}}]}]}],false]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>The result</h2>\n<p>Bucher + Suter launched with a clearer strategy, sharper identity and a website built around the problems their customers actually face.</p>\n<p>The refreshed logo improves recognition. The colour system brings control and personality. The wave gives the brand a distinctive expression of integration. The website creates clearer journeys and stronger commercial relevance.</p>\n<p>Most importantly, Bucher + Suter now has a clearer way to explain its value, make decisions and keep the brand moving forward.</p>\n<p><!-- notionvc: 74b4d7e4-29df-4ca6-9142-7f8b1e414dee --></p>\n"}}]}]}],null]}]}],["$","$L23","20",{"data":{"fieldGroupName":"Project_Singleproject_ContentBuilder_BeforeAfter","marginBottom":"default","beforeImage":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/bs-before-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2026/06/bs-before-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/06/bs-before-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2026/06/bs-before.jpg 1440w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/bs-before.jpg","mediaDetails":{"width":1440,"height":810}},"afterImage":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/06/bs-after-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2026/06/bs-after-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/06/bs-after-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2026/06/bs-after.jpg 1440w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/06/bs-after.jpg","mediaDetails":{"width":1440,"height":810}}},"brandColour":"#b8c8ff"}]]}],null,null,"$L24"]}]]
