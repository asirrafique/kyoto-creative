":"https://kota-content.b-cdn.net/app/uploads/2022/06/Headspace.jpg","mediaDetails":{"width":2360,"height":1229}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$1e"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1b",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1a",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2022/06/Misfits-1400x729.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2022/06/Misfits-2000x1042.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2022/06/Misfits-500x260.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2022/06/Misfits-768x400.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2022/06/Misfits-1536x800.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2022/06/Misfits-2048x1067.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2022/06/Misfits.jpg","mediaDetails":{"width":2360,"height":1229}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>3. Translating across all touchpoints.</h2>\n<p>These days a brand reach has multiplied due to the digital experience such as websites, mobile apps and digital platforms. They open up a whole swathe of brand touchpoints that enable brands to inject their values, personality and tone of voice.</p>\n<p>A straightforward way to bring your brand identity into digital experiences is by taking aspects of your core visual identity such as colour palette, typography, icons, and photography style and applying them across digital touchpoints.</p>\n<p>To ensure consistency with offline and online experiences the key is to strip the brand down to the simplest possible recognisable visual expressions. For example, for the recent rebrand of <a href=\"https://jkrglobal.com/case-studies/burger-king/\" target=\"_blank\" rel=\"noopener\">Burger King by JKRGlobal</a>, you can see real-life aspects of the brand, such as packaging and billboards, successfully translated across social media, through animation and typography.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1b",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1a",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2022/06/Burger-King-1400x729.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2022/06/Burger-King-2000x1042.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2022/06/Burger-King-500x260.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2022/06/Burger-King-768x400.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2022/06/Burger-King-1536x800.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2022/06/Burger-King-2048x1067.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2022/06/Burger-King.jpg","mediaDetails":{"width":2360,"height":1229}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>4. The role of photography in branding.</h2>\n<p>Once your brand’s logo, fonts and colours are locked down, photography is a great way to visually translate your brand’s personality into something more recognisable for your audience. Like we discussed earlier in understanding your target audience and personality, your photography style will need to successfully represent these traits. Bespoke photography will be super effective in engaging your core consumers, but you need to establish a consistent visual style right from the start.</p>\n<p>The cosmetic and skincare brand <a href=\"https://www.glossier.com/\" target=\"_blank\" rel=\"noopener\">Glossier</a> is a great example of a company that uses photography to highlight their products and appeal to their target audience. Focused on natural, breathable skin and make-up, their brand photography reflects this with their dream-like and glossy models and product shots.</p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1b",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1a",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2022/06/Glossier-1-1400x729.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2022/06/Glossier-1-2000x1042.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2022/06/Glossier-1-500x260.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2022/06/Glossier-1-768x400.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2022/06/Glossier-1-1536x800.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2022/06/Glossier-1-2048x1067.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2022/06/Glossier-1.jpg","mediaDetails":{"width":2360,"height":1229}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>5. Brands that stand for something.</h2>\n<p>Taking a stand on social issues and not being afraid to align your values to a cause is another way to make your brand memorable, authentic and build customer loyalty. According to a Kantar study, 68% of US consumers expect brands to be clear about their values, with Millennials and Gen Z having the highest expectations of all age groups.</p>\n<p>Using Nike again as an example, they often create campaigns in support of social causes like the Black Lives Matter movement. In 2020, <a href=\"https://news.nike.com/news/nike-for-once-don-t-do-it-film\" target=\"_blank\" rel=\"noopener\">a campaign created by Wieden + Kennedy</a> involved a series of statements urgently calling for both consumers and companies to stand together in the fight against racism. Putting a twist on its famous motto, Nike said:</p>\n<p>“For once, don’t do it. Don’t pretend there’s not a problem in America. Don’t turn your back on racism.”</p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1b",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1a",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2022/06/Nike-1400x729.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2022/06/Nike-2000x1042.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2022/06/Nike-500x260.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2022/06/Nike-768x400.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2022/06/Nike-1536x800.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2022/06/Nike-2048x1067.jpg 2048w","sourceUrl":"