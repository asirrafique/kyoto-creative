out1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/03-1-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2026/08/03-1-2000x1126.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2026/08/03-1-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/08/03-1-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2026/08/03-1-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2026/08/03-1-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/03-1.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/02-bank.jpg 1190w, https://kota-content.b-cdn.net/app/uploads/2026/08/02-bank-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/08/02-bank-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/02-bank.jpg","mediaDetails":{"width":1190,"height":1190}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/01-bank.jpg 1190w, https://kota-content.b-cdn.net/app/uploads/2026/08/01-bank-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/08/01-bank-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/01-bank.jpg","mediaDetails":{"width":1190,"height":1190}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><strong>The challenge</strong></h2>\n<p>People use comparison sites, but they don’t always feel great about them. How are results ranked? Who gets their data? Will the rate they click still exist once they apply?</p>\n<p>Bankrate needed to challenge those assumptions and give people a clear reason to see it differently.</p>\n<p>Through stakeholder interviews, customer research, social listening and category analysis, we defined the brand’s central job: <strong>earn, protect and reward consumer trust at every step.</strong></p>\n<p><!-- notionvc: 05a5b8db-6c11-44af-9d6d-9000451ecc62 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/12-1400x835.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2026/08/12-2000x1193.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2026/08/12-500x298.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/08/12-768x458.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2026/08/12-1536x916.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2026/08/12-2048x1221.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/12.jpg","mediaDetails":{"width":2448,"height":1460}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/10.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2026/08/10-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2026/08/10-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/10.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/11.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2026/08/11-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2026/08/11-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/11.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><strong>The strategy</strong></h2>\n<p>Bankrate had the technology, scale and relationships. The challenge was putting that power to work for the person comparing rates at their kitchen table.</p>\n<p>We positioned Bankrate as an active connector and advocate, helping people find products that fit their lives and make more confident decisions.</p>\n<p>Every search and comparison also strengthens the platform, giving Bankrate more power to secure better rates and prove its people-first promise through every interaction.</p>\n<p><!-- notionvc: 66078cfb-0b62-49e6-a7f5-0553bc612626 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"SingleImage_singleImage__NY3zv","data-margin":"default","children":["$","$L20",null,{"children":[false,["$","div",null,{"className":"SingleImage_fullWidthImage__nPNe8","children":["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/09-1-1400x787.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2026/08/09-1-2000x1124.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2026/08/09-1-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/08/09-1-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2026/08/09-1-1536x863.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2026/08/09-1-2048x1151.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/09-1.jpg","mediaDetails":{"width":2448,"height":1376}}}]}]]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><strong>The visual identity</strong></h2>\n<p>The identity grew from one idea: financial decisions are about people, not numbers.</p>\n<p>Hand-drawn elements and expressive illustrations bring warmth and real life into the system, helping Bankrate explain complex topics without defaulting to familiar finance clichés.</p>\n<p>The new logo puts the consumer at the centre, while a softer beige balances the recognisable dark blue. The result feels trusted and established, but warmer, more human and far less institutional.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container",