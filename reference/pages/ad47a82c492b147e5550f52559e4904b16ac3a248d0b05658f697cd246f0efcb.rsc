__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/14-1400x835.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2026/08/14-2000x1193.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2026/08/14-500x298.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/08/14-768x458.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2026/08/14-1536x916.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2026/08/14-2048x1221.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/14.jpg","mediaDetails":{"width":2448,"height":1460}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/13-1400x835.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2026/08/13-2000x1193.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2026/08/13-500x298.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/08/13-768x458.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2026/08/13-1536x916.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2026/08/13-2048x1221.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/13.jpg","mediaDetails":{"width":2448,"height":1460}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><strong>The tone of voice</strong></h2>\n<p>Financial copy has a habit of hiding useful information beneath jargon, disclaimers and corporate waffle. That’s a problem when trust depends on people understanding what they’re choosing.</p>\n<p>We created a clearer, more approachable voice, with a messaging system that gives their teams guidance, keeping the brand consistent without sounding like it’s been through twelve rounds of legal review.</p>\n<p>Trust now comes through in how the Bankrate speaks, rather than simply being something it claims.</p>\n<p><!-- notionvc: 4dd22cfb-75e0-48ff-8ad7-935189140a1d --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"SingleImage_singleImage__NY3zv","data-margin":"default","children":["$","$L20",null,{"children":[["$","div",null,{"className":"container","children":["$","div",null,{"className":"SingleImage_containedImage__N2jLD","children":["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/18-1400x835.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2026/08/18-2000x1193.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2026/08/18-500x298.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/08/18-768x458.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2026/08/18-1536x916.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2026/08/18-2048x1221.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/18.jpg","mediaDetails":{"width":2448,"height":1460}}}]}]}],false]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout4__cFAXt","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/21.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2026/08/21-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2026/08/21-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/21.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/22.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2026/08/22-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2026/08/22-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/22.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],false,false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>The digital experience</h2>\n<p>Trust had to live in the product, not gather dust in a brand deck.</p>\n<p>We applied the strategy and identity across key desktop and mobile journeys, including the homepage, comparison templates, editorial content, partnership pages and trust-focused modules.</p>\n<p>Clearer hierarchy makes dense information easier to navigate. Warmer visuals create a more recognisable experience. Helpful reassurance appears when people need it, without slowing them down or cluttering the decision.</p>\n<p><!-- notionvc: 3f2641e2-51e9-4a91-b970-e8411c85ca8e --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/15-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2026/08/15-2000x1126.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2026/08/15-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2026/08/15-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2026/08/15-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2026/08/15-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/15.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/16.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2026/08/16-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2026/08/16-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/16.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/08/17.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2026/08/17-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2026/08/17-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/08/17.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-c