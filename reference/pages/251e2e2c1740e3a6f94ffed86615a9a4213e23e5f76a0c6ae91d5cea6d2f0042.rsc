Media_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.40.28-1400x715.png 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.40.28-2000x1021.png 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.40.28-500x255.png 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.40.28-768x392.png 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.40.28-1536x784.png 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.40.28-2048x1045.png 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.40.28-2560x1307.png","mediaDetails":{"width":3346,"height":1708}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>What are KOTA doing?</h2>\n<p>Since 2021 we’ve been looking to actively offset our carbon footprint, putting more focus on how our work affects the environment. Through <a href=\"https://ecologi.com/kota\">Ecologi</a> we have started to sponsor trees and begin planting small forests across the world.</p>\n<p>We plant 100 trees for each KOTA team birthday, 500 to 1000 trees for each website launch, and offset whenever we do team meet-ups. Em is our dedicated Sustainability Skipper, where she updates each new planting in our #sustainability Slack channel.</p>\n<p>KOTA have planted 3,684 trees to date, with more website go-lives/birthdays (and therefore planting)  planned over the next few weeks. See our forest grow <a href=\"https://ecologi.com/kota\">here</a>!</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.42.40-1400x694.png 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.42.40-2000x992.png 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.42.40-500x248.png 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.42.40-768x381.png 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.42.40-1536x762.png 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.42.40.png 2024w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Screenshot-2022-08-05-at-11.42.40.png","mediaDetails":{"width":2024,"height":1004}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$21"}}]}]}]}]}]]}],["$","$L22",null,{}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"BlogPost_buttonOuter__M9Wmd","children":["$","$L1a",null,{"children":["$","$L11",null,{"type":"a-internal","href":"/blog","text":"Back to blog","direction":"backwards"}]}]}]}],["$","section",null,{"className":"RelatedPosts_relatedPosts__xfLkb","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"RelatedPosts_headingOuter__r3TEg","children":[["$","p",null,{"className":"RelatedPosts_heading__3kOeH",