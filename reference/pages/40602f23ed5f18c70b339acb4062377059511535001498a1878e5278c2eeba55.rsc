0x298.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2025/07/website-2-768x458.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2025/07/website-2-1536x916.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2025/07/website-2-2048x1221.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/07/website-2.jpg","mediaDetails":{"width":2448,"height":1460}},"lazy":false,"priority":"high","sizes":"100vw"}],false]}]}]]}],["$","section",null,{"className":"Intro_intro__kvY3Y","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Intro_text__1JkoM","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>After launching in 2023, Ziipline have scaled at a rapid rate, growing from just the co-founders, to a team of over 50 in under two years. Their problem solving, strategic approach to Salesforce consulting and implementation landed them clients like Hargreaves Lansdown and News UK with their collaborative, fast and scalable ethos.</p>\n<p>Their business was scaling fast. But their brand and website? Still stuck in start-up mode. A DIY Squarespace site and a visual identity that didn’t reflect their momentum, capability, or culture.</p>\n<p>They needed a brand that matched their ambition—and a website that could keep up.</p>\n<p><!-- notionvc: aa66529d-d49b-40c9-bd6a-9f6e3737c56b --></p>\n"}}]}]}],["$","div",null,{"className":"Intro_projectDetails__UWcsm","children":[["$","div",null,{"className":"Intro_left__d8bha","children":["$","$L1d",null,{"delay":0.15,"children":[["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Industry"}],["$","p",null,{"children":"B2B tech, software & SaaS"}]]}],["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Location"}],["$","p",null,{"children":"UK, London"}]]}]]}]}],["$","div",null,{"className":"Intro_right__E3UWy","children":["$","$L1d",null,{"delay":0.15,"children":null}]}]]}],["$","div",null,{"className":"Intro_link__Wrq2r","children":["$","$L1d",null,{"delay":0.3,"children":["$","a",null,{"href":"https://www.mgnevents.co.uk/","target":"_blank","style":{"backgroundColor":"#fc4759","borderColor":"#fc4759"},"children":[["$","span",null,{"className":"$undefined","children":"Visit site"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 12.6 12.6","className":"Intro_buttonArrow___9UE0","children":[["$","path",null,{"fill":"#fff","d":"M11.85 12.6c-.41 0-.75-.34-.75-.75V1.5H.75C.34 1.5 0 1.16 0 .75S.34 0 .75 0h11.1c.41 0 .75.34.75.75v11.1c0 .41-.34.75-.75.75z"}],["$","path",null,{"fill":"#fff","d":"M1.13 12.21c-.19 0-.38-.07-.53-.22a.754.754 0 010-1.06L11.32.22c.29-.29.77-.29 1.06 0 .29.29.29.77 0 1.06L1.66 11.99c-.15.15-.34.22-.53.22z"}]]}]]}]}]}]]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__FAKQG","children":[["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L1f",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout4__cFAXt","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/07/Website-Animation_2.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/07/Ziipline-Bento-Grid.mp4","layout":"intrinsic"}]]}],false,false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h3>The brief</h3>\n<p>Ziipline came to KOTA with a clear goal: level up every part of their brand presence. Not just a slick new site, but a full strategic rethink. The kind that could define their positioning in a crowded market, show off their human, high-calibre team, attract enterprise clients and top-tier talent, and turn the website into a genuine marketing tool.</p>\n<p>We were commissioned to deliver:</p>\n<ul>\n<li>Brand strategy and messaging</li>\n<li>Tone of voice and copywriting</li>\n<li>Evolved brand identity</li>\n<li>Brand video art direction and production</li>\n<li>Website design and build</li>\n<li>SEO, CMS, training and ongoing support.</li>\n</ul>\n<p>The challenge was to make them look and sound like the market leader they already were behind the scenes.</p>\n<p><!-- notionvc: 739e4452-3e2a-4828-bc3c-5bb1671986a3 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"$undefined","data-margin":"default","children":[false,["$","div",null,{"className":"$undefined","children":["$","$L21",null,{"data":{"__typename":"Project_Singleproject_ContentBuilder_SingleVideo","fieldGroupName":"Project_Singleproject_ContentBuilder_SingleVideo","alignment":"fullPageWidth","marginBottom":"default","loop":{"mediaItemUrl":"https://kota-content.b-cdn.net/app/uploads/2025/07/Website.mp4"},"fullVideo":null}}]}]]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h3>The thinking</h3>\n<p>We started with discovery—speaking to stakeholders, reviewing the market, analysing competitors and mapping user needs. Then we got to work shaping their strategic foundation.</p>\n<p>Through a series of workshops and collaborative sessions, we helped Ziipline:</p>\n<ul>\n<li>Articulate their difference (non-transactional, deeply strategic)</li>\n<li>Structure their services for clarity and conversion</li>\n<li>Define their value prop for enterprise clients</li>\n<li>Establish a bold, confident tone of voice</li>\n<li>Create a scalable messaging system to guide all future comms.</li>\n</ul>\n<p>This gave us everything we needed to write the full website copy and build a verbal identity that sounded nothing like their competitors.</p>\n<p><!-- notionvc: 52b453f1-013c-4918-986d-2d18985a2885 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L1f",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/07/Mobile.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/07/Col.jpg 1189w, https://kota-content.b-cdn.net/app/uploads/2025/07/Col-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2025/07/Col-768x890.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/07/Col.jpg","mediaDetails":{"width":1189,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/07/Col-1.jpg 1190w, https://kota-content.b-cdn.net/app/uploads/2025/07/Col-1-432x500.jpg 432w, https://kota-content.b-cdn.net/app/uploads/2025/07/Col-1-768x889.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/07/Col-1.jpg","mediaDetails":{"width":1190,"height":1378}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h3>The brand &amp; build</h3>\n<p>We didn’t throw the old brand in the bin—we refined it. We kept the loop in the logo and the distinctive coral as a nod to their origin, then pushed everything forward.</p>\n<p>What we delivered:</p>\n<ul>\n<li>Three initial brand concepts, one final evolved identity</li>\n<li>Custom typography, colour system and iconography</li>\n<li>Digital-first online brand guidelines (visual + verbal)</li>\n<li>A bold, modern website with storytelling at its heart</li>\n<li>Flexible CMS, CRM integration, and SEO baked in</li>\n<li>A scalable team section to showcase their fast-growing crew</li>\n<li>Case study layouts focused on outcomes, not just outputs.</li>\n</ul>\n<p><!-- notionvc: 23541529-ca7b-4e54-aaa3-657147a005ec --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"$undefined","data-margin":"default","children":[["$","div",null,{"className":"container","children":["$","div",null,{"className":"SingleImage_containedImage__N2jLD","children":["$","$L21",null,{"data":{"__typename":"Project_Singleproject_ContentBuilder_SingleVideo","fieldGroupName":"Project_Singleproject_ContentBuilder_SingleVideo","alignment":"contained","marginBottom":"default","loop":{"mediaItemUrl":"https://kota-content.b-cdn.net/app/uploads/2025/07/ziipline1_08-720p.mp4"},"fullVideo":null}}]}]}],false]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h3>The result</h3>\n<p>Ziipline now has a brand and digital presence that reflects who they really are: a fast-scaling, culture-led consultancy delivering large-scale Salesforce transformations with a human edge.</p>\n<p>They’ve got:</p>\n<p>✔ A site built for lead generation and recruitment</p>\n<p>✔ A tone of voice that feels smart, warm and distinctive</p>\n<p>✔ A brand system they can grow into, not out of</p>\n<p>✔ A toolkit to stay consistent as they expand</p>\n<p>From a founder-built Squarespace site to a confident, strategic platform—this is what levelling up looks like.</p>\n<p><!-- notionvc: 79a91fb1-d8ae-4815-b482-92ecc5628e9a --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"SingleImage_singleImage__NY3zv","data-margin":"default","children":["$","$L22",null,{"children":[["$","div",null,{"className":"container","children":["$","div",null,{"className":"SingleImage_containedImage__N2jLD","children":["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/07/branding-1400x798.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2025/07/branding-2000x1141.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2025/07/branding-500x285.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2025/07/branding-768x438.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2025/07/branding-1536x876.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2025/07/branding-2048x1168.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/07/branding.jpg","mediaDetails":{"width":2448,"height":1396}}}]}]}],false]}]}],["$","section",null,{"className":"Quote_quote__8BTRS","data-margin":"default","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Quote_quoteContent__SngAv","children":[["$","$L1d",null,{"children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 38.48 36.59","children":["$","path",null,{"fill":"#fc4759","d":"M0 0l1.71 36.59h10.26L13.68 0H0zm24.8 0l1.71 36.59h10.26L38.48 0H24.8z"}]}]}],["$","$L1d",null,{"children":["$","p",null,{"className":"Quote_quoteText__isGTS","children":"\"After a personal recommendation, we brought KOTA in to evolve our brand from top to bottom. They took the time to understand not just what we did as a company, but the people involved and brought that to life through our updated TOV and a refreshed look that matched the work we've been doing for the last two years. If you want your brand to reflect your ambition - this is the agency to do it\""}]}],["$","$L1d",null,{"children":["$","div",null,{"className":"Quote_attribution__LU91Y","children":[["$","p",null,{"className":"Quote_attributionName__ABzkp","children":"Jake Stevens"}],["$","p",null,{"className":"Quote_attributionByline__d9bMk","children":"Co-Founder, Ziipline"}]]}]}]]}]}]}],["$","$L23","10",{"data":{"fieldGroupName":"Project_Singleproject_ContentBuilder_BeforeAfter","marginBottom":"default","beforeImage":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/07/before-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2025/07/before-2000x1125.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2025/07/before-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2025/07/before-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2025/07/before-1536x864.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2025/07/before-2048x1152.jpg 2048w","sourceUrl":"h