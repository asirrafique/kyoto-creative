a-content.b-cdn.net/app/uploads/2025/09/bipsync-featured-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2025/09/bipsync-featured-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2025/09/bipsync-featured-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2025/09/bipsync-featured.jpg 1440w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/09/bipsync-featured.jpg","mediaDetails":{"width":1440,"height":810}},"layout":"fill"}],["$","video",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/09/Company-Loop4-compressed-2.mp4","className":"ProjectCard_video__AheFz","autoPlay":true,"muted":true,"loop":true,"preload":"none","playsInline":true}]]}]]}]]}]}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"RelatedProjects_viewAllLinkMobile__pDKQH","children":["$","$L11",null,{"type":"a-internal","text":"View all projects","color":"white","href":"/work"}]}]}]]}],["$","section",null,{"className":"FaqsList_faqsList__W3Ud0","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":[["$","div",null,{"className":"FaqsList_heading__kNT8k","children":["$","p",null,{"children":["$","$L32",null,{"children":"FAQ's"}]}]}],[["$","div","0",{"className":"FaqsList_faq__k2u7Q","children":["$","$L32",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Why choose a team with strategists, designers and developers under one roof?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">When strategists, designers and developers work closely together from day one, ideas translate into reality more smoothly. There’s less back-and-forth, fewer compromises and a clearer path from concept to launch. The result is a website that not only looks great but is built to perform, with design decisions and technical execution working hand in hand throughout the project.</span><!-- notionvc: 3709c11d-eed8-4661-a7f6-e0193a53e7ee --></p>\n<p><!-- notionvc: 3709c11d-eed8-4661-a7f6-e0193a53e7ee --></p>\n"}}]}]]}]}],["$","div","1",{"className":"FaqsList_faq__k2u7Q","children":["$","$L32",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What’s included in a web development project?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Most projects include front-end development, back-end development, CMS setup, responsive build, animation, interaction, testing, performance optimisation and launch support. Depending on the project, we can also support integrations, WebGL, 3D experiences, SEO migration and ongoing maintenance.</span></p>\n"}}]}]]}]}],["$","div","2",{"className":"FaqsList_faq__k2u7Q","children":["$","$L32",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What makes your development approach different?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">We approach development as a craft, not just a production task. Our developers work closely with designers from the outset to ensure creative ideas are delivered with precision, performance and attention to detail. The result is a website that feels considered in every interaction, not just visually impressive on launch day.</span></p>\n"}}]}]]}]}],["$","div","3",{"className":"FaqsList_faq__k2u7Q","children":["$","$L32",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Do you consider SEO during development?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Always! Technical SEO is integrated throughout the development process, including site architecture, semantic markup, performance optimisation, accessibility, metadata, redirects and indexation. Building these foundations correctly helps search engines, AI platforms and users navigate your website more effectively.</span></p>\n"}}]}]]}]}],["$","div","4",{"className":"FaqsList_faq__k2u7Q","children":["$","$L32",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Will the website be easy for our team to update?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yes. We build intuitive CMS solutions that balance flexibility with control. Your team will be able to manage content confidently without compromising the design or functionality of the site, and we provide training to ensure a smooth handover.</span></p>\n"}}]}]]}]}],["$","div","5",{"className":"FaqsList_faq__k2u7Q","children":["$","$L32",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Can you integrate with our existing tools?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yes. We regularly integrate websites with CRM systems, marketing platforms, analytics tools, e-commerce platforms, recruitment software and bespoke business systems. Our experience across a wide range of technologies helps ensure integrations are reliable, scalable and future-proof.</span><br />\n<!-- notionvc: feb6b1eb-854e-4fd3-9541-3d910603fc87 --></p>\n"}}]}]]}]}]]]}]]}],"$L35","$L36"]}]]
37:I[9377,["922","static/chunks/c15bf2b0-7fe4609d5aed7ee2.js","6689","static/chunks/b536a0f1-48e07d9a196acd0d.js","210","static/chunks/c6a54c64-52e4c013414e73d2.js","1550","static/chunks/1550-75709fc12a079aa2.js","1242","static/chunks/1242-b8f16838e7608b53.js","6644","static/chunks/6644-79af0604a55e02a8.js","4434","static/chunks/4434-660c906de7f131e6.js","4143","static/chunks/4143-6b83e17252ec01c2.js","988","static/chunks/988-86d1af1c6c90b59b.js","4048","static/chunks/app/service/%5Bslug%5D/page-53d2604786d625db.js"],"default"]
21:["$","section",null,{"className":"Intro_intro__B7xXJ","children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"$undefined","children":["$","$L1a",null,{"children":["$","span",null,{"children":"Built to behave beautifully."}]}]}],["$","div",null,{"className":"Intro_text__4DPtt prose","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Ambitious designs often lose something in development. Movement becomes clunky, systems become restrictive, and the experience starts to feel compromised. We create websites with thoughtful engineering, refined interactions and flexible foundations that make every experience feel effortless.</span></p>\n"}}]}]}]]}]}]
22:["$","section",null,{"className":"TextImageRows_textImageRows__lOU02","children":["$","div",null,{"className":"container","children":[[["$","div","0",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Front-end development."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>We turn creative designs into responsive, polished digital experiences that feel smooth across devices. From layouts and components to transitions, hover states and micro-interactions, every detail is built to support the idea, not flatten it.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L37",null,{"fill":true,"children":[["$","$L34",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/01/front-end-development.jpg 1224w, https://kota-content.b-cdn.net/app/uploads/2024/01/front-end-development-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/01/front-end-development-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/01/front-end-development.jpg","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","1",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Back-end development."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>We build robust back-end systems that make websites easy to manage, scale and evolve. From CMS architecture to APIs and custom functionality, we create foundations that stay powerful without becoming complicated.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L37",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/01/Backend-Dev3.mp4","layout":"fill"}]]}]}]]}],["$","div","2",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Animations & interaction."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Motion brings pace, personality and focus to a website when it’s done properly. We build animations and interactive moments that guide attention, add depth and make the experience feel more memorable without getting in the way.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L37",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/01/Figma-Prototyping-Ig-V2-1.mp4","layout":"fill"}]]}]}]]}]],false]}]}]
