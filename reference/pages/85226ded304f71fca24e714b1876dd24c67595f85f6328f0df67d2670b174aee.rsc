21:["$","section",null,{"className":"Intro_intro__B7xXJ","children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"$undefined","children":["$","$L1a",null,{"children":["$","span",null,{"children":"Visibility is changing. Your strategy should too."}]}]}],["$","div",null,{"className":"Intro_text__4DPtt prose","children":["$","$L1d",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">People are asking AI tools for recommendations, summaries, comparisons and expert answers before they ever reach your website. We help brands build the foundations to show up in those moments, with improvements that make your expertise easier to find, easier to trust, and easier to cite.</span></p>\n"}}]}]}]]}]}]
22:["$","section",null,{"className":"TextImageRows_textImageRows__lOU02","children":["$","div",null,{"className":"container","children":[[["$","div","0",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"SEO strategy."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1d",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>We define the search opportunities that matter most for your brand, audience and commercial goals. That means looking beyond vanity rankings to understand intent, competition, content gaps and the pages most likely to drive useful traffic.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L2e",null,{"fill":true,"children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/11/seo-strategy.jpg 1224w, https://kota-content.b-cdn.net/app/uploads/2023/11/seo-strategy-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/11/seo-strategy-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/11/seo-strategy.jpg","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","1",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"GEO strategy."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1d",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Generative engine optimisation helps your brand become easier for AI search tools and LLMs to understand, reference and recommend. We improve content clarity, entity signals, topical authority and structured information so your brand has a better chance of appearing in AI-led discovery.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L2e",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2023/11/geo-strategy-V2.mp4","layout":"fill"}]]}]}]]}],["$","div","2",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Content optimisation."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1d",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Good content needs to answer the right questions with enough depth, clarity and credibility to earn attention. We optimise pages, blogs and service content around search intent, audience needs, internal linking, metadata and AI search visibility.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L2e",null,{"fill":true,"children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/11/content-optimisation.jpg 1224w, https://kota-content.b-cdn.net/app/uploads/2023/11/content-optimisation-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/11/content-optimisation-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/11/content-optimisation.jpg","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","3",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRow