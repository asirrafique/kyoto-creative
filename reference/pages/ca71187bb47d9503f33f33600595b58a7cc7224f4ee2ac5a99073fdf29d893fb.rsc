etails":{"width":2448,"height":1378}}}]}]}],false]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"false","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Branding.</h2>\n<p>We began with working on a new brand strategy and tine of voice for Brinkworth. What we discovered is at the heart of the work they create are real life experiences of humans and our interaction with each other. The concept around their &#8216;big idea&#8217; was that they uncover these stories through trust, and bring the subject matter into the public eye, hence the tagline &#8216;Revealed Human Experiences&#8217;.</p>\n<p>This concept of &#8216;revealing&#8217; is then highlighted in the visual identity, with a blurred shape being used to intersect images of the people in the documentaries. We carried across their strong brand red and off black colour palette and created a new logo and icon that reveals only parts of the letterforms.</p>\n"}}]}]}],["$","div",null,{"className":"TextLeftListRight_right__PqYzo","children":["$","div",null,{"className":"rightInner","children":["$","$L1d",null,{"children":[["$","p",null,{"className":"TextLeftListRight_listHeading__f3Gy_","children":"What we did:"}],["$","div",null,{"className":"TextLeftListRight_list__syEal","children":[["$","li","0",{"children":"Brand Strategy"}],["$","li","1",{"children":"Tone of Voice"}],["$","li","2",{"children":"Logo & Icon Design"}],["$","li","3",{"children":"Brand Identity"}],["$","li","4",{"children":"Web Design & Build"}]]}]]}]}]}]]}]}],["$","section",null,{"className":"SingleImage_singleImage__NY3zv","data-margin":"default","children":["$","$L1f",null,{"children":[false,["$","div",null,{"className":"SingleImage_fullWidthIma