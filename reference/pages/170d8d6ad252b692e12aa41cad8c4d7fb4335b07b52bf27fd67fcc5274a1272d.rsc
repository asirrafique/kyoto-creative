children":["$","$L1c",null,{"fill":true,"delay":0.45,"children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/process-1-1400x748.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/process-1-2000x1068.webp 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/process-1-500x267.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/process-1-768x410.webp 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/process-1-1536x820.webp 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/process-1-2048x1094.webp 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/process-1.webp","mediaDetails":{"width":2339,"height":1249}},"layout":"fill","lazy":false}]}]}],false]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__jY2p_","children":[["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<div class=\"WrapText-sc-mvwj17-3 fiDqGy\">\n<div class=\"MainContent-sc-mvwj17-4 eDWTRI\">\n<h2>Introduction.</h2>\n<p>Welcome! We’re KOTA – a progressive and insightful design agency focused on creating impactful, engaging brands and immersive digital experiences. We combine art, strategy, design and technology to create beautiful and functional web experiences. Our team of digital experts knows that well-designed websites offer much more than just aesthetics and that behind every successful project stands a strong strategy and a clearly defined process.</p>\n<p>With more than 10 years of KOTA’s experience and over 100 launched projects, plus even more satisfied clients, we’re confident to say: we know how to do it and to do it well.</p>\n<p>&nbsp;</p>\n</div>\n</div>\n<div class=\"WrapText-sc-mvwj17-3 fiDqGy\">\n<div class=\"MainContent-sc-mvwj