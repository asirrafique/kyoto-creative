et/app/uploads/2024/03/02-12-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/03/02-12-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/03/02-12-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/03/02-12.jpg","mediaDetails":{"width":2448,"height":1378}},"lazy":false,"priority":"high","sizes":"100vw"}],false]}]}]]}],["$","section",null,{"className":"Intro_intro__kvY3Y","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Intro_text__1JkoM","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>Tribepad are a B2B, Saas recruitment software provider based in Sheffield, who have been growing steadily for the last few years. They provide talent acquisition software to some of the best-known companies such as Tesco, BBC and Pizza Hut. They do so by using all the latest tech including video and AI to deliver an amazing experience to candidates, hiring managers and recruiters.</p>\n<p>Tribepad approached KOTA to design and build a website that was optimised for search, looked modern, responsive and had an excellent user experience. The quality of the site needed to reflect the quality of their products and services.</p>\n"}}]}]}],["$","div",null,{"className":"Intro_projectDetails__UWcsm","children":[["$","div",null,{"className":"Intro_left__d8bha","children":["$","$L1d",null,{"delay":0.15,"children":[["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Industry"}],["$","p",null,{"children":"SaaS"}]]}],["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Location"}],["$","p",null,{"children":"UK"}]]}]]}]}],["$","div",null,{"className":"Intro_right__E3UWy","children":["$","$L1d",null,{"delay":0.15,"children":null}]}]]}],["$","div",null,{"className":"Intro_link__Wrq2r","child