lassName":"ProjectCard_tags__XdVcf","children":[[["$","li","Web design & development",{"children":"Web design & development"}]],[["$","li","Agencies",{"children":"Agencies"}]]]}]]}],["$","$L33",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-FeaturedImage-1400x788.png 1400w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-FeaturedImage-500x281.png 500w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-FeaturedImage-768x432.png 768w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-FeaturedImage-1536x864.png 1536w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-FeaturedImage.png 1920w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-FeaturedImage.png","mediaDetails":{"width":1920,"height":1080}},"layout":"fill"}],["$","video",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-FeatureVideo.mp4","className":"ProjectCard_video__AheFz","autoPlay":true,"muted":true,"loop":true,"preload":"none","playsInline":true}]]}]]}]]}]}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"RelatedProjects_viewAllLinkMobile__pDKQH","children":["$","$L11",null,{"type":"a-internal","text":"View all projects","color":"white","href":"/work"}]}]}]]}],["$","section",null,{"className":"FaqsList_faqsList__W3Ud0","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":[["$","div",null,{"className":"FaqsList_heading__kNT8k","children":["$","p",null,{"children":["$","$L31",null,{"children":"FAQ's"}]}]}],[["$","div","0",{"className":"FaqsList_faq__k2u7Q","children":["$","$L31",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What’s included in a creative web design project?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Most projects include discovery, UX planning, sitemap development, wireframes, creative direction, front-end design, UI components, Figma prototypes, responsive page designs and website animation. Depending on the project, we can also support copywriting, SEO, development and ongoing optimisation.</span></p>\n"}}]}]]}]}],["$","div","1",{"className":"FaqsList_faq__k2u7Q","children":["$","$L31",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Can you build immersive or interactive websites?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Absolutely. We love to create cinematic web experiences using motion, WebGL, 3D and carefully considered interaction where the idea calls for it. </span><span style=\"font-weight: 400;\">The technology always needs a reason to exist. We use immersive elements to strengthen storytelling, create emotional impact and make the brand more memorable, rather than adding effects for the sake of showing off.</span></p>\n"}}]}]]}]}],["$","div","2",{"className":"FaqsList_faq__k2u7Q","children":["$","$L31",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"How do you balance creativity with usability?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">By treating them as part of the same problem. </span><span style=\"font-weight: 400;\">Creative design gives people a reason to notice and remember the experience. Good UX helps them understand it and take the next step. We design both together, so originality never becomes an excuse for confusion.</span></p>\n"}}]}]]}]}],["$","div","3",{"className":"FaqsList_faq__k2u7Q","children":["$","$L31",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Do you consider SEO during the web design process?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yes. SEO considerations feed into the sitemap, content structure, page hierarchy, technical build, performance and migration planning. </span><span style=\"font-weight: 400;\">A strong website should be easy for people to use and easy for search engines and AI platforms to understand. We can also provide additional support with deeper SEO strategy, copywriting and ongoing optimisation.</span></p>\n"}}]}]]}]}],["$","div","4",{"className":"FaqsList_faq__k2u7Q","children":["$","$L31",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Do we need a new brand before starting the website?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Not always. We can work with an established identity, evolve what you already have or develop a new brand before moving into the website. The important thing is having enough strategic and visual clarity to create a digital experience that feels intentional. </span><span style=\"font-weight: 400;\">Where branding and web design happen together, our Brand-to-Build approach carries one central idea across the entire experience.</span></p>\n"}}]}]]}]}],["$","div","5",{"className":"FaqsList_faq__k2u7Q","children":["$","$L31",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"How do you make a website feel distinctive?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">We start with the brand, not the trend. Your positioning, audience, personality and commercial goals shape the creative direction, while motion, interaction and art direction bring the experience to life in a way that feels specific to you.</span></p>\n"}}]}]]}]}]]]}]]}],"$L34","$L35"]}]]
36:I[9377,["922","static/chunks/c15bf2b0-7fe4609d5aed7ee2.js","6689","static/chunks/b536a0f1-48e07d9a196acd0d.js","210","static/chunks/c6a54c64-52e4c013414e73d2.js","1550","static/chunks/1550-75709fc12a079aa2.js","1242","static/chunks/1242-b8f16838e7608b53.js","6644","static/chunks/6644-79af0604a55e02a8.js","4434","static/chunks/4434-660c906de7f131e6.js","4143","static/chunks/4143-6b83e17252ec01c2.js","988","static/chunks/988-86d1af1c6c90b59b.js","4048","static/chunks/app/service/%5Bslug%5D/page-53d2604786d625db.js"],"default"]
21:["$","section",null,{"className":"Intro_intro__B7xXJ","children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"$undefined","children":["$","$L1a",null,{"children":["$","span",null,{"children":"Creative that carries the business."}]}]}],["$","div",null,{"className":"Intro_text__4DPtt prose","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Your website should create atmosphere, build momentum and give people a reason to keep going. We bring brand thinking, UX and visual design together to create digital experiences with a clear point of view, a commercial purpose, and enough confidence to stand out.</span></p>\n"}}]}]}]]}]}]
22:["$","section",null,{"className":"TextImageRows_textImageRows__lOU02","children":["$","div",null,{"className":"container","children":[[["$","div","0",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Brand-to-build web design."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>We take the thinking behind your brand and turn it into a digital experience with purpose, personality and momentum. Every page connected to the strategy, not decorated after the fact.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L36",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2023/11/Brand-To-Web-Bankrate-V2.mp4","layout":"fill"}]]}]}]]}],["$","div","1",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":" Conversion-led UX."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>We shape the interface people actually use, from page layouts and component systems to buttons, navigation, forms and micro-interactions. Every detail has a job: make the experience clearer, sharper and more recognisably yours.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L36",null,{"fill":true,"children":[["$","$L33",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/01/Web-Development-Cambridge-Intelligence.jpg 1224w, https://kota-content.b-cdn.net/app/uploads/2024/01/Web-Development-Cambridge-Intelligence-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/01/Web-Development-Cambridge-Intelligence-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/01/Web-Development-Cambridge-Intelligence.jpg","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","2",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Front-end design and UI."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>We shape the visual world of your website through layout, typography, imagery, motion and interaction. The goal is simple: make the experience feel clear, considered, and unmistakably yours from the first second.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L36",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/01/Front-End-Design-Goat-compressed.mp4","layout":"fill"}]]}]}]]}],["$","div","3",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Figma prototyping."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>We use Figma to explore, test and refine key interactions before development begins. Prototypes help everyone understand how the website will move, flow and behave, so the experience feels considered before it’s built.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L36",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/01/Figma-Prototyping-Ig-V2.mp4","layout":"fill"}]]}]}]]}],["$","div","4",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Immersive website animation."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>We love designing animation, transitions and interactive moments that make your website feel alive. Motion adds pace, depth and atmosphere to the experience, helping your brand land emotionally as well as functionally.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L36",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/01/Immersive-Website-Animation-compressed-1.mp4","layout":"fill"}]]}]}]]}],["$","div","5",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"WebGL."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>For brands that want to break away from the expected, we create WebGL experiences that feel impossible to ignore. Rich 3D environments, cinematic motion and interactive storytelling combine to create digital experiences that pull people in.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L36",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/01/Webgl-Upp-V4-compressed.mp4","layout":"fill"}]]}]}]]}]],false]}]}]
