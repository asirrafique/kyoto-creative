0464-1400x1050.jpeg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0464-2000x1500.jpeg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0464-500x375.jpeg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0464-768x576.jpeg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0464-1536x1152.jpeg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0464-2048x1536.jpeg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0464.jpeg","mediaDetails":{"width":2500,"height":1875}},"layout":"fill","lazy":false}]}]}],false]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__jY2p_","children":[["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><span style=\"font-weight: 400;\">Introduction.</span></h2>\n<p><span style=\"font-weight: 400;\">As a remote team, we have limited opportunities to see one another IRL. That’s why we organise team socials every few months, to have some fun together and catch up about things other than work. </span></p>\n<p><span style=\"font-weight: 400;\">Everyone loved the trip to Amsterdam we had before Corona, so this time, we went on another team trip abroad &#8211; to Porto! We hoped to catch some Portuguese sun, eat a whole lot of pastéis de nata and have fun.</span></p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Image-from-iOS-2-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Image-from-iOS-2-2000x1500.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Image-from-iOS-2-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Image-from-iOS-2-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Image-from-iOS-2-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Image-from-iOS-2-2048x1536.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Image-from-iOS-2.jpg","mediaDetails":{"width":2500,"height":1875}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$1e"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8013-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8013-2000x1500.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8013-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8013-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8013-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8013-2048x1536.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8013-2560x1920.jpg","mediaDetails":{"width":2560,"height":1920}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>&nbsp;</p>\n<h3><a href=\"https://maps.app.goo.gl/i5mCaE7duFFhQ2RR8\"><span style=\"font-weight: 400;\">Port @ Candelabro</span></a></h3>\n<p><span style=\"font-weight: 400;\">Lovely local bar with outdoor seating where we enjoyed some port wine (which was very good, both red and white). They also have a bookshop, but sadly, none of us can read Portuguese.</span></p>\n<p>&nbsp;</p>\n<h3><a href=\"https://maps.app.goo.gl/CfE5i6S54g4r55x37\"><span style=\"font-weight: 400;\">Champagne @ Brutt</span></a></h3>\n<p><span style=\"font-weight: 400;\">Located just next door to Candelabro, we popped in to Brutt for champagne, to celebrate our meetup.</span></p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8046-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8046-2000x1500.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8046-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8046-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8046-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8046-2048x1536.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8046-2560x1920.jpg","mediaDetails":{"width":2560,"height":1920}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>&nbsp;</p>\n<h3><a href=\"https://maps.app.goo.gl/PsfTnjo3GN11GPN86\"><span style=\"font-weight: 400;\">Dinner @ BOA-BAO</span></a></h3>\n<p><span style=\"font-weight: 400;\">For dinner, we went to BOA-BAO, a highly rated Pan-Asian restaurant. We enjoyed some dumplings, noodles, and (as their name indicates) bao. Great find!</span></p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-08-04-2022-20-24-05-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-08-04-2022-20-24-05-2000x1500.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-08-04-2022-20-24-05-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-08-04-2022-20-24-05-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-08-04-2022-20-24-05-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-08-04-2022-20-24-05.jpg 2006w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-08-04-2022-20-24-05.jpg","mediaDetails":{"width":2006,"height":1504}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8055-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8055-2000x1500.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8055-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8055-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8055-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8055-2048x1536.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_8055-2560x1920.jpg","mediaDetails":{"width":2560,"height":1920}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>&nbsp;</p>\n<p><span style=\"font-weight: 400;\">After that, we took a stroll, admiring the city at night.</span></p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>&nbsp;</p>\n<h2><b>Day 2</b></h2>\n<h3><a href=\"https://goo.gl/maps/DZoQZongFum4FoXi6\"><span style=\"font-weight: 400;\">Breakfast @ Zenith</span></a></h3>\n<p><span style=\"font-weight: 400;\">Zenith is another must-go place for foodies in Porto. We went for breakfast, but they also do brunches and excellent cocktails.</span></p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>&nbsp;</p>\n<h2><span style=\"font-weight: 400;\">Photoshoot &amp; Sightseeing</span></h2>\n<p><span style=\"font-weight: 400;\">We felt that the team photography we currently have on the website doesn’t reflect us anymore, as we don’t go to the office anymore. So, as our website is getting a little facelift (we’ll tell you more about it soon), we had new photos for our studio page taken. </span></p>\n<p><span style=\"font-weight: 400;\">There was no theme, it was just a fun and relaxed photoshoot to show our team just as we are IRL.</span></p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0487-e1649870822647-1400x1058.jpeg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0487-e1649870822647-2000x1512.jpeg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0487-e1649870822647-500x378.jpeg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0487-e1649870822647-768x581.jpeg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0487-e1649870822647-1536x1161.jpeg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0487-e1649870822647-2048x1548.jpeg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0487-e1649870822647.jpeg","mediaDetails":{"width":2491,"height":1883}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>&nbsp;</p>\n<h3><a href=\"https://g.page/adegaleonor?share\"><span style=\"font-weight: 400;\">Lunch @ Adega Leonor</span></a></h3>\n<p><span style=\"font-weight: 400;\">We had tapas-style lunch (washed down with sangria) at a small pub by Jardim de João Chagas. Simple but tasty food and friendly staff, a perfect place to chill out after a long walk. </span></p>\n<p><span style=\"font-weight: 400;\">We were also lucky to watch a capoeira practice with live music on a nearby pavilion.</span></p>\n<p>&nbsp;</p>\n<h3><span style=\"font-weight: 400;\">Boat Trip @ Douro River</span></h3>\n<p><span style=\"font-weight: 400;\">Porto’s impressive bridges are best seen from the Douro! We went on a boat trip to see them all and find out more about the nearby tourist attractions.</span></p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0510-1400x1050.jpeg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0510-2000x1500.jpeg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0510-500x375.jpeg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0510-768x576.jpeg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0510-1536x1152.jpeg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0510-2048x1536.jpeg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0510.jpeg","mediaDetails":{"width":2500,"height":1875}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>&nbsp;</p>\n<h3><a href=\"https://www.google.com/maps/place/Pizzaria+Luzzo+%7C+Baixa+do+Porto/@41.1431985,-8.6[%E2%80%A6]46d5ca40!8m2!3d41.1432038!4d-8.6137665?authuser=2&amp;hl=en&amp;gl=uk\"><span style=\"font-weight: 400;\">Dinner @ Pizzaria Luzzo</span></a></h3>\n<p><span style=\"font-weight: 400;\">For dinner, we settled for a restaurant close to the hotel. It’s a decent local pizzeria with nice interiors. We could even pick from Napolitan or Roman style.</span></p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0537-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0537-2000x1500.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0537-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0537-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0537-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0537-2048x1536.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0537.jpg","mediaDetails":{"width":2500,"height":1875}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2><b>Day 3</b></h2>\n<h3><a href=\"https://maps.app.goo.gl/FD1VBAVvDLdyRaBi6\"><span style=\"font-weight: 400;\">Breakfast @ Fábrica da Nata</span></a></h3>\n<p><span style=\"font-weight: 400;\">Before we headed to the airport, we enjoyed our breakfast outside in the sun at a small cafe specialising in natas near São Bento.</span></p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-10-04-2022-09-51-11-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-10-04-2022-09-51-11-2000x1500.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-10-04-2022-09-51-11-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-10-04-2022-09-51-11-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-10-04-2022-09-51-11-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-10-04-2022-09-51-11-2048x1535.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Photo-10-04-2022-09-51-11-2560x1919.jpg","mediaDetails":{"width":2560,"height":1919}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>Then it was time to go home!</p>\n<p>&nbsp;</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0555-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0555-2000x1500.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/IMG_0555-500x375.jpg 500w, https://kota-content.b