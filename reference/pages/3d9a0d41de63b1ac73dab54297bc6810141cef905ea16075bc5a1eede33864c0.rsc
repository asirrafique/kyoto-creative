_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h3>The result</h3>\n<p>The result is a website that sets a new standard for the maritime industry. Elegant, intuitive, and deeply interactive, it reflects Navarino’s role as a true technology partner to the world’s leading shipping companies.</p>\n<p>The new platform empowers their team, engages their audiences, and positions Navarino exactly where they belong—at the forefront of innovation in maritime connectivity.</p>\n<p><!-- notionvc: 2d773761-092b-40f5-9b61-1a6809ed9046 --></p>\n"}}]}]}],null]}]}],["$","$L23","9",{"data":{"fieldGroupName":"Project_Singleproject_ContentBuilder_BeforeAfter","marginBottom":"default","beforeImage":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/09/navarino-before-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2025/09/navarino-before-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2025/09/navarino-before-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2025/09/navarino-before.jpg 1440w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/09/navarino-before.jpg","mediaDetails":{"width":1440,"height":810}},"afterImage":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/09/navarino-after-1-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2025/09/navarino-after-1-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2025/09/navarino-after-1-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2025/09/navarino-after-1.jpg 1440w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/09/navarino-after-1.jpg","mediaDetails":{"width":1440,"height":810}}},"brandColour":"#286af8"}],["$","section",null,{"className":"Quote_quote__8BTRS","data-margin":"default","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Quote_quoteContent__SngAv","children":[