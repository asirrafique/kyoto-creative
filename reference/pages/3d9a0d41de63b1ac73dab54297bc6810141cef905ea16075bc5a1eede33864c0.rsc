":"https://kota-content.b-cdn.net/app/uploads/2025/09/Bento2a-compressed.mp4"}]]}],["$","div",null,{"className":"Bento_media3__Je_Pc","data-animation":"grid-item","children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/09/Bento3-compresed.mp4"}]]}],["$","div",null,{"className":"Bento_media4__xfRDt","data-animation":"grid-item","children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/09/Bento4a.mp4"}]]}]]}]}]}],false,false]}],["$","section",null,{"className":"Intro_intro__kvY3Y","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Intro_text__1JkoM","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>Navarino is a global leader in maritime technology and connectivity, serving one in three merchant vessels worldwide. With offices spanning eight countries and a reputation for innovation, they needed a digital presence that matched their industry-leading position.</p>\n<p>Their old site was weighed down by too much information, an overwhelming navigation system, and little interactivity. The new site had to cut through the noise with clarity, elegance, and intuitive UX.</p>\n<p>That’s where KOTA came in.</p>\n"}}]}]}],["$","div",null,{"className":"Intro_projectDetails__UWcsm","children":[["$","div",null,{"className":"Intro_left__d8bha","children":["$","$L1d",null,{"delay":0.15,"children":[["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Industry"}],["$","p",null,{"children":"Maritime Technology"}]]}],["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Location"}],["$","p",null,{"children":"Global"}]]}]]}]}],["$","div",null,{"className":"Intro_right__E3UWy","children":["$","$L1d",null,{"delay":0.15,"children":null}]}]]}],["$","div",null,{"className":"Intro_link__Wrq2r","children":["$","$L1d",null,{"delay":0.3,"children":["$","a",null,{"href":"https://navarino.co.uk/","target":"_blank","style":{"backgroundColor":"#286af8","borderColor":"#286af8"},"children":[["$","span",null,{"className":"$undefined","children":"Visit site"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 12.6 12.6","className":"Intro_buttonArrow___9UE0","children":[["$","path",null,{"fill":"#fff","d":"M11.85 12.6c-.41 0-.75-.34-.75-.75V1.5H.75C.34 1.5 0 1.16 0 .75S.34 0 .75 0h11.1c.41 0 .75.34.75.75v11.1c0 .41-.34.75-.75.75z"}],["$","path",null,{"fill":"#fff","d":"M1.13 12.21c-.19 0-.38-.07-.53-.22a.754.754 0 010-1.06L11.32.22c.29-.29.77-.29 1.06 0 .29.29.29.77 0 1.06L1.66 11.99c-.15.15-.34.22-.53.22z"}]]}]]}]}]}]]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__FAKQG","children":[["$","section",null,{"className":"$undefined","data-margin":"default","children":[false,["$","div",null,{"className":"$undefined","children":["$","$L21",null,{"data":{"__typename":"Project_Singleproject_ContentBuilder_SingleVideo","fieldGroupName":"Project_Singleproject_ContentBuilder_SingleVideo","alignment":"fullPageWidth","marginBottom":"default","loop":{"mediaItemUrl":"https://kota-content.b-cdn.net/app/uploads/2025/09/Feature1-V4-compressed.mp4"},"fullVideo":null}}]}]]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h3>The brief</h3>\n<p>Navarino commissioned KOTA to redesign their website to reflect their status as one of the most innovative names in maritime technology. The goals were:</p>\n<ul>\n<li>A minimalist yet sophisticated design that stands out in their sector, combining isometric 3D models with a clean look and feel.</li>\n<li>Elegant data visualisations and micro-animations to showcase their technology in action.</li>\n<li>A streamlined navigation system to quickly guide different users—ship owners, IT managers, or partners—to the right information.</li>\n<li>A CMS flexible enough to empower the Navarino marketing team to update and expand the site with ease.</li>\n<li>SEO optimisation, training, and ongoing support to ensure long-term performance.</li>\n</ul>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L1f",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/09/Group-compressed.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/09/site3-4.jpg 1080w, https://kota-content.b-cdn.net/app/uploads/2025/09/site3-4-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2025/09/site3-4-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/09/site3-4.jpg","mediaDetails":{"width":1080,"height":1080}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/09/site4-3.jpg 1080w, https://kota-content.b-cdn.net/app/uploads/2025/09/site4-3-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2025/09/site4-3-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/09/site4-3.jpg","mediaDetails":{"width":1080,"height":1080}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h3>Design highlights</h3>\n<p>The site makes use of clean layouts, subtle interactions, and animated storytelling that keeps complex information accessible without diluting its impact.</p>\n<ul>\n<li><strong>Minimalist elegance</strong> – a clean, high-tech look that aligns with Navarino’s innovation-first reputation.</li>\n<li><strong>Micro-animations</strong> – subtle motion brings data, diagrams, and product stories to life.</li>\n<li><strong>Typography</strong> – a bold but refined treatment ensures clarity and reinforces authority.</li>\n<li><strong>Colour system</strong> – a balanced palette with light and dark contrasts that ensure a modern, high-tech aesthetic that still feels approachable.</li>\n<li><strong>Streamlined navigation</strong> – Instead of overwhelming menus, we created intuitive user journeys tailored to Navarino’s multiple audiences, helping each visitor find what they need faster.</li>\n</ul>\n<p><!-- notionvc: 4c3e8077-090b-4c2b-a2a5-ec0ba3fa1478 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L1f",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout2__oUjwC","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L20",