esign & development"}],["$","div","dGVybTo1Mw==",{"className":"Hero_service__YURmU","children":"Brand strategy"}],["$","div","dGVybTo1MQ==",{"className":"Hero_service__YURmU","children":"Tone of voice"}],["$","div","dGVybTo1Mg==",{"className":"Hero_service__YURmU","children":"Brand identity"}]]}]}]}],["$","div",null,{"className":"Hero_arrow__KkhoQ","children":["$","$L1e",null,{"delay":0.9,"children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 75.91 75.65","children":["$","path",null,{"d":"m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z"}]}]}]}]]}]]}]}],["$","section",null,{"className":"Bento_bento__pskN5","children":[false,false,["$","div",null,{"className":"container","children":["$","div",null,{"className":"Bento_contained__4KAWy","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Homepage-Hero.mp4"}]]}]}]]}],["$","section",null,{"className":"Intro_intro__kvY3Y","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Intro_text__1JkoM","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>Copper gives institutions the infrastructure to hold, trade, settle and move collateral across digital asset markets. As the platform, product range and ambition grew, the brand needed to catch up.</p>\n<p>KOTA built a clearer strategy and bolder identity around one idea: Copper connects always-on markets. The result gives a complex offer a simpler story, brings confidence to an evolving category and avoids looking like another fintech drowning in navy blue.</p>\n<p><!-- notionvc: 79ee152a-a015-4302-9ead-13ada022a6e8 --></p>\n"}}]}]}],["$","div",null,{"className":"Intro_projectDetails__UWcsm","children":[["$","div",null,{"className":"Intro_left__d8bha","children":["$","$L1d",null,{"delay":0.15,"children":[["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Industry"}],["$","p",null,{"children":"Finance"}]]}],["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Location"}],["$","p",null,{"children":"London"}]]}]]}]}],["$","div",null,{"className":"Intro_right__E3UWy","children":["$","$L1d",null,{"delay":0.15,"children":null}]}]]}],["$","div",null,{"className":"Intro_link__Wrq2r","children":["$","$L1d",null,{"delay":0.3,"children":["$","a",null,{"href":"https://copper.co/","target":"_blank","style":{"backgroundColor":"#d29d86","borderColor":"#d29d86"},"children":[["$","span",null,{"className":"$undefined","children":"Visit site"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 12.6 12.6","className":"Intro_buttonArrow___9UE0","children":[["$","path",null,{"fill":"#fff","d":"M11.85 12.6c-.41 0-.75-.34-.75-.75V1.5H.75C.34 1.5 0 1.16 0 .75S.34 0 .75 0h11.1c.41 0 .75.34.75.75v11.1c0 .41-.34.75-.75.75z"}],["$","path",null,{"fill":"#fff","d":"M1.13 12.21c-.19 0-.38-.07-.53-.22a.754.754 0 010-1.06L11.32.22c.29-.29.77-.29 1.06 0 .29.29.29.77 0 1.06L1.66 11.99c-.15.15-.34.22-.53.22z"}]]}]]}]}]}]]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__FAKQG","children":[["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout3__ywDoB","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Logo-Guide.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/07/Logo-Symbol.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/07/Logo-Symbol-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/07/Logo-Symbol-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/07/Logo-Symbol.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/07/Logo-Symbol-Phone.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/07/Logo-Symbol-Phone-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/07/Logo-Symbol-Phone-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/07/Logo-Symbol-Phone.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media4__biNHW","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Logos.mp4","layout":"intrinsic"}]]}],false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>The challenge</h2>\n<p>Copper had outgrown the brand built for its earlier stage. The business spanned regulated custody, technology products and an ecosystem of banks, asset managers, custodians, trading venues and infrastructure partners.</p>\n<p>It needed to communicate scale and technical expertise without becoming cold, cautious or impossible to follow. The balance was simple to describe but harder to achieve: more ambition than traditional finance, but more discipline than the usual crypto hype.</p>\n<p><!-- notionvc: 9cce0162-0088-4ab1-bcd8-f84fd76c7ba9 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Desktop-Compilation-V2.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/07/Web-1.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/07/Web-1-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/07/Web-1-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/07/Web-1.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/07/Web-2.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/07/Web-2-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/07/Web-2-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/07/Web-2.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Finding the bigger story</h2>\n<p>Copper’s technology is sophisticated. Its commercial story needed to be simpler.</p>\n<p>We mapped the ecosystem, separated platform users from network partners, and identified where the brand should focus. One problem kept surfacing: markets operate around the clock, but institutional infrastructure often can’t keep pace. Risk becomes concentrated. Collateral gets fragmented across different venues and custodians. Capital moves more slowly than the markets around it.</p>\n<p>That led to a stronger position: <strong>infrastructure that connects 24/7 markets</strong>, bringing custody, settlement and collateral management together as one connected system that keeps capital moving.</p>\n<p><!-- notionvc: 69b0554c-ada2-4655-b311-2bf49ad1cf79 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Tagline-V2.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Illustration1-V2.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Illustration-2.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Turning complexity into a clear proposition</h2>\n<p>We organised Copper’s proposition around three outcomes:</p>\n<ol>\n<li>Secure access to always-on markets</li>\n<li>Keep capital in motion</li>\n<li>Mobilise at the speed of markets</li>\n</ol>\n<p>Together, they show how institutions can trade across venues while assets remain in custody, deploy collateral more efficiently and respond through real-time infrastructure.</p>\n<p>The structure also flexes across different audiences, from banks exploring new services to trading firms that care about speed, precision, control and keeping capital working harder.</p>\n<p><!-- notionvc: 1150f1c9-e6c3-4fbd-8044-138e00ba6437 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Illustration-3.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Illustration-4.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Illustration-5.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Precision in motion</h2>\n<p>The identity takes its cue from Copper’s infrastructure: interconnected, exact and always moving.</p>\n<p>Its new symbol draws on elliptic-curve cryptography, the mathematical foundation used to secure digital signatures, wallets and encrypted systems. That scientific precision runs through the wider identity, from Regola, Richmond and technical illustrations to flexible grids and bespoke icons.</p>\n<p>Charcoal and white bring authority, while oxide, lilac, salmon and mint add welcome energy beyond the category’s corporate blues.</p>\n<p><!-- notionvc: 3cc9e633-5dfc-46fb-96a4-f4f63cb17f50 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout3__ywDoB","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/EllipticCurve.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/07/Icons-Multiple-1400x1400.png 1400w, https://kota-content.b-cdn.net/app/uploads/2026/07/Icons-Multiple-500x500.png 500w, https://kota-content.b-cdn.net/app/uploads/2026/07/Icons-Multiple-768x768.png 768w, https://kota-content.b-cdn.net/app/uploads/2026/07/Icons-Multiple-1536x1536.png 1536w, https://kota-content.b-cdn.net/app/uploads/2026/07/Icons-Multiple.png 1620w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/07/Icons-Multiple.png","mediaDetails":{"width":1620,"height":1620}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/07/Colours-1.png 1188w, https://kota-content.b-cdn.net/app/uploads/2026/07/Colours-1-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2026/07/Colours-1-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/07/Colours-1.png","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media4__biNHW","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Colour-Ratio-V2.mp4","layout":"intrinsic"}]]}],false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>A voice with quiet authority</h2>\n<p>Financial infrastructure copy lands in one of two places: painfully stiff or wildly over-caffeinated. Neither suited Copper.</p>\n<p>We created a voice that’s clear, intelligent, quietly confident and active. It explains complex products without making people work for meaning, leads with evidence and focuses on what institutions can move, connect and improve.</p>\n<p>The result feels calm, commercially aware and human, without crypto theatrics, abstract promises or fear dressed up as urgency.</p>\n<p><!-- notionvc: f9f10a90-c149-48b2-abfd-d28d3165fff5 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Copper-ToV.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Mobile-1.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Mobile-2.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>One system for a growing global brand</h2>\n<p>We brought Copper’s strategy, identity and voice together in an accessible digital brand book covering logo use, colour, typography, illustration, grids, messaging and real-world applications.</p>\n<p>Teams and partners now have one practical source of truth across channels, products and regions.</p>\n<p>The result gives Copper’s complex platform one coherent story: credible in the rooms it already operates in, distinctive enough to lead and built for the global scale of business ahead.</p>\n<p><!-- notionvc: fcf4ff47-6b41-4817-a63a-e635417628c1 --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Socials-V2.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Portrait.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2026/07/Landscape.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}]]}],null,null,"$L21"]}]]
