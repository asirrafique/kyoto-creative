","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/Right-Formula-Globe.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout6__wJx6J","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/Right-Formula-Carousel.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/08/Website-01.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2025/08/Website-01-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2025/08/Website-01-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/08/Website-01.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/08/Website-02.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2025/08/Website-02-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2025/08/Website-02-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/08/Website-02.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media4__biNHW","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/Right-Formula-UI.mp4","layout":"intrinsic"}]]}],false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>The brief</h2>\n<p>We were briefed to build something bold. A digital flagship that felt high-end and high-octane. It had to balance elegance with energy. And it had to look nothing like the cookie-cutter templates used by competitors.</p>\n<p>Right Formula lives and breathes premium sport. Their home turf is Formula 1, but their influence stretches across golf, MotoGP, rugby and football. This is high-performance stuff—and the new site needed to reflect that. Sophisticated, but never static. Energetic, but never chaotic.</p>\n<p><!-- notionvc: 94d0403d-a7f9-4508-a40f-94cf287676de --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout2__oUjwC","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/Right-Formula-TOV.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/08/Logo-Lines.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2025/08/Logo-Lines-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2025/08/Logo-Lines-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/08/Logo-Lines.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/Right-Formula-Scroll.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>What we did</h2>\n<p>We dialled in their new digital presence with the perfect balance of sleek editorial design and kinetic movement. Animated lines and subtle refractions add a layer of finesse, while large, confident typography sets the tone for the brand’s bold, expert voice. It’s refined. It&#8217;s confident. It feels like them.</p>\n<p>Everything about the new site is driven by Right Formula’s brand DNA: innovation, agility, and unshakable expertise. We pushed their existing typography to work harder—bringing in movement, blur, and layout shifts to mirror the ever-changing world of sport. And because their work is best experienced in motion, we leaned into high-quality video and immersive imagery to give their case studies and content serious stopping power.</p>\n<p><!-- notionvc: 4228112c-c698-46f1-a6ff-eac90f9335da --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout2__oUjwC","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/08/Website-02-1.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2025/08/Website-02-1-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2025/08/Website-02-1-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/08/Website-02-1.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/Right-Formula-Video.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/Right-Formula-Mobile.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>The results</h2>\n<p>The result? A site that doesn’t just match their competitors. It laps them.<!-- notionvc: 664de920-6bcf-47c1-b325-e80d0e124d40 --></p>\n<p>Right Formula now has a digital flagship that finally does justice to their unique positioning in the sports marketing space. A platform that reflects their status as trusted partners and industry leaders, while giving them the flexibility to grow and evolve. Because when you’re building lasting legacies for your clients, your website should do the same for you.<!-- notionvc: 2bd021e3-a659-47d8-b9ac-73841c1ef17b --></p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"Results_results__xMS5p","data-margin":"default","children":["$","div",null,{"className":"container","children":[["$","h3",null,{"className":"Results_heading__f0DwF","children":["$","$L1d",null,{"children":["$","span",null,{"children":"Results so far"}]}]}],["$","div",null,{"className":"Results_resultsContent__fDMiF","children":["$","$L20",null,{"children":["$","div",null,{"className":"Results_resultsContentInner__gRwSH","children":[["$","div","0",{"className":"Results_result__7T6EL","style":{"backgroundColor":"#000000","color":"#fff"},"data-animation":"grid-item","children":[["$","span",null,{"className":"Results_figure__t8hvp","children":"+35.2%"}],["$","span",null,{"className":"Results_description__KhIC1","children":"In new users after 1 month"}]]}],["$","div","1",{"className":"Results_result__7T6EL","style":{"backgroundColor":"#000000","color":"#fff"},"data-animation":"grid-item","children":[["$","span",null,{"className":"Results_figure__t8hvp","children":"+63.3%"}],["$","span",null,{"className":"Results_description__KhIC1","children":"In clicks after 1 month"}]]}],["$","div","2",{"className":"Results_result__7T6EL","style":{"backgroundColor":"#000000","color":"#fff"},"data-animation":"grid-item","children":[["$","span",null,{"className":"Results_figure__t8hvp","children":"+19.5%"}],["$","span",null,{"className":"Results_description__KhIC1","children":"In organic search visits after 1 month"}]]}]]}]}]}]]}]}]]}],null,null,"$L21"]}]]
