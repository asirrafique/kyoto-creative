captures their energy, reflects their creative edge, and gives their team the freedom to grow, adapt and publish at pace.</p>\n<p>From big-picture brand positioning to the smallest micro-interaction, everything is designed to support their mission to Influence Everywhere, and to make sure their website can keep the pace.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"Results_results__xMS5p","data-margin":"default","children":["$","div",null,{"className":"container","children":[["$","h3",null,{"className":"Results_heading__f0DwF","children":["$","$L1d",null,{"children":["$","span",null,{"children":"Results"}]}]}],["$","div",null,{"className":"Results_resultsContent__fDMiF","children":["$","$L21",null,{"children":["$","div",null,{"className":"Results_resultsContentInner__gRwSH","children":[["$","div","0",{"className":"Results_result__7T6EL","style":{"backgroundColor":"#fc430b","color":"#fff"},"data-animation":"grid-item","children":[["$","span",null,{"className":"Results_figure__t8hvp","children":"+63.8% "}],["$","span",null,{"className":"Results_description__KhIC1","children":"increase in user engagement after 1 month."}]]}],["$","div","1",{"className":"Results_result__7T6EL","style":{"backgroundColor":"#fc430b","color":"#fff"},"data-animation":"grid-item","children":[["$","span",null,{"className":"Results_figure__t8hvp","children":"+59.6% "}],["$","span",null,{"className":"Results_description__KhIC1","children":"increase in active users after 1 month."}]]}],["$","div","2",{"className":"Results_result__7T6EL","style":{"backgroundColor":"#fc430b","color":"#fff"},"data-animation":"grid-item","children":[["$","span",null,{"className":"Results_figure__t8hvp","children":"+110.1%"}],["$","span",null,{"className":"Results_description__KhIC1","children":"Increase in sessions from organic search after 1 month."}]]}]]}]}]}]]}]}]]}],["$","section",null,{"className":"RelatedPosts_relatedPosts__xfLkb","children":[["$","$L10",null,{}],["$","div",null,{"className":"conta