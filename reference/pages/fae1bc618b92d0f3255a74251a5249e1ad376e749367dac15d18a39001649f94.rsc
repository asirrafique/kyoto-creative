n":"$undefined"}],"\n"]],["$","$L19",null,{}],["$","div",null,{"children":[["$","section",null,{"className":"Hero_hero__3FzZ4","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Hero_top__wOuEd","children":[["$","h1",null,{"children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Influence everywhere: a future-ready website for The Goat Agency."}}]}]}],["$","div",null,{"className":"Hero_image__zxcFf","children":["$","$L1b",null,{"fill":true,"delay":0.6,"children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-Logo.png 730w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-Logo-500x500.png 500w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-Logo.png","mediaDetails":{"width":730,"height":730}},"lazy":false,"priority":"high","sizes":"22.8125rem"}],false]}]}]]}],["$","div",null,{"className":"Hero_bottom__9I3wO","children":[["$","div",null,{"className":"Hero_services__nHZa_","children":["$","$L1d",null,{"delay":0.25,"children":["$","div",null,{"className":"Hero_servicesInner__vQpTC","children":[["$","div","dGVybTo4",{"className":"Hero_service__YURmU","children":"Web design & development"}]]}]}]}],["$","div",null,{"className":"Hero_arrow__KkhoQ","children":["$","$L1e",null,{"delay":0.9,"children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 75.91 75.65","children":["$","path",null,{"d":"m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z"}]}]}]}]]}]]}]}],["$","section",null,{"className":"Bento_bento__pskN5","children":[false,false,["$","div",null,{"className":"container","children":["$","div",null,{"className":"Bento_contained__4KAWy","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-Hero.mp4"}]]}]}]]}],["$","section",null,{"className":"Intro_intro__kvY3Y","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Intro_text__1JkoM","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Introduction</h2>\n<p>It’s something we see time and time again: fast-growing, creative businesses outpacing their own websites. And as an agency ourselves, we get it. You evolve quickly, the brand moves on—and suddenly your digital presence no longer reflects who you are, or where you’re heading.</p>\n<p>That was the case for The Goat Agency. From early pioneers in influencer marketing to a global leader driving the future of human-first media, Goat had grown far beyond what their five-year-old site could represent.</p>\n<p>We partnered with them to rebuild their online presence from the ground up—creating an engaging, intuitive, future-ready platform that captures the scale, personality and creativity of one of the biggest names in the game.</p>\n"}}]}]}],["$","div",null,{"className":"Intro_projectDetails__UWcsm","children":[["$","div",null,{"className":"Intro_left__d8bha","children":["$","$L1d",null,{"delay":0.15,"children":[["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Industry"}],["$","p",null,{"children":"Online Video Editing"}]]}],["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Location"}],["$","p",null,{"children":"UK & USA "}]]}]]}]}],["$","div",null,{"className":"Intro_right__E3UWy","children":["$","$L1d",null,{"delay":0.15,"children":null}]}]]}],["$","div",null,{"className":"Intro_link__Wrq2r","children":["$","$L1d",null,{"delay":0.3,"children":["$","a",null,{"href":"https://goatagency.com/","target":"_blank","style":{"backgroundColor":"#fc430b","borderColor":"#fc430b"},"children":[["$","span",null,{"className":"$undefined","children":"Visit site"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 12.6 12.6","className":"Intro_buttonArrow___9UE0","children":[["$","path",null,{"fill":"#fff","d":"M11.85 12.6c-.41 0-.75-.34-.75-.75V1.5H.75C.34 1.5 0 1.16 0 .75S.34 0 .75 0h11.1c.41 0 .75.34.75.75v11.1c0 .41-.34.75-.75.75z"}],["$","path",null,{"fill":"#fff","d":"M1.13 12.21c-.19 0-.38-.07-.53-.22a.754.754 0 010-1.06L11.32.22c.29-.29.77-.29 1.06 0 .29.29.29.77 0 1.06L1.66 11.99c-.15.15-.34.22-.53.22z"}]]}]]}]}]}]]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__FAKQG","children":[["$","section",null,{"className":"$undefined","data-margin":"default","children":[["$","div",null,{"className":"container","children":["$","div",null,{"className":"SingleImage_containedImage__N2jLD","children":["$","$L20",null,{"data":{"__typename":"Project_Singleproject_ContentBuilder_SingleVideo","fieldGroupName":"Project_Singleproject_ContentBuilder_SingleVideo","alignment":"contained","marginBottom":"default","loop":{"mediaItemUrl":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-Desktop-V2.mp4"},"fullVideo":null}}]}]}],false]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h3>The challenge</h3>\n<p>Goat’s previous site had become cluttered, static and hard to manage, held back by a clunky backend, dated structure, and a visual style that no longer reflected their scale or ambition.</p>\n<p>They needed a site that could keep up. One that felt bold and beautiful, showed off their global footprint and creative edge, and made space for the video-first storytelling that defines their work. It had to be fast, seamless, SEO-optimised and genuinely easy to use—for both visitors and their own team. Most of all, it needed to help them tell the story of where they’re going next.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout2__oUjwC","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-Homepage.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-A.png 891w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-A-430x500.png 430w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-A-768x892.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-A.png","mediaDetails":{"width":891,"height":1035}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-Timeline-V1.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h3>The design</h3>\n<p>The Goat Agency was ready to move on from the heavy black aesthetic of the old site. In its place, we introduced a vibrant visual language led by bold orange accents, and shifted toward bright, editorial-style layouts with generous white space and high contrast.</p>\n<p>As a trend-aware brand that lives at the forefront of digital culture, they needed a visual identity that matched their energy. We looked to modern editorial design for inspiration, crafting dynamic page layouts that feel as sharp and style-conscious as the creators they work with.</p>\n<p>We also tackled the lack of interactivity. To bring the site to life, we layered in parallax typography, interactive image treatments and custom carousels. And across key pages—from the homepage to the Work section—we wove in rich video content to showcase Goat’s world through sight, sound and movement.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-Projects-V3.mp4","layout":"intrinsic"}]]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-B.png 891w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-B-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-B-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-B.png","mediaDetails":{"width":891,"height":1034}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-C.png 891w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-C-431x500.png 431w, https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-C-768x891.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/08/GOAT-C.png","mediaDetails":{"width":891,"height":1034}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h3>The development</h3>\n<p>We restructured the entire platform to deliver something faster, sharper, and ready for growth.</p>\n<p>Navigation was reimagined from the ground up to create a clearer, more intuitive user journey. We built a modular content system that lets the Goat team spin up new landing pages in minutes—no dev needed. A fully flexible CMS means updates are quick and seamless, whether they’re swapping out stats or adding new team members.</p>\n<p>We developed a robust content hub for blogs, vlogs, reports and events, with smart filtering and internal linking to keep users exploring. Across the board, we brought in slick transitions, micro-interactions and embedded video to inject energy and momentum. And underneath it all, we made sure the site is lightning-fast, mobile-optimised, and SEO-ready from day one.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L21",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout6__wJx6J","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[false,["$","$L