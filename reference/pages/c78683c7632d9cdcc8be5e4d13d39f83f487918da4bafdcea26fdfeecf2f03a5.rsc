ta-content.b-cdn.net/app/uploads/2024/03/06-10-2000x1126.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/03/06-10-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/03/06-10-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/03/06-10-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/03/06-10-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/03/06-10.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/03/05-10.jpg 1190w, https://kota-content.b-cdn.net/app/uploads/2024/03/05-10-432x500.jpg 432w, https://kota-content.b-cdn.net/app/uploads/2024/03/05-10-768x889.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/03/05-10.jpg","mediaDetails":{"width":1190,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/03/04-10.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2024/03/04-10-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2024/03/04-10-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/03/04-10.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],false,false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>The Approach.</h2>\n<p>The &#8216;wow&#8217; moment we implemented was a 3D parallax header effect that feels like the user is in the middle of the crowd at each of the venues. This was achieved by constructing a composition from hi-res photography supplied by the client, making sure to get the correct mixture of people and reactions in the crowd for the venue being promoted.</p>\n<p>Splitting the composition into its foreground, middle ground and background elements meant we were able to control how each layer animates, ultimately creating the 3D illusion. Each venue has its own interior, with the crowd effect being triggered on lateral mouse movement and on scroll down, into the rest of the homepage content.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L20",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/03/07-10-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/03/07-10-2000x1126.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/03/07-10-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/03/07-10-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/03/07-10-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/03/07-10-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/03/07-10.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/u