lassName":"FaqsList_heading__kNT8k","children":["$","p",null,{"children":["$","$L33",null,{"children":"FAQ's"}]}]}],[["$","div","0",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What is SiteCare?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">SiteCare is KOTA’s ongoing website support and maintenance retainer. It helps keep your website secure, stable and performing properly after launch, with support for hosting, updates, monitoring, fixes, reporting and ongoing improvements.</span></p>\n<p><span style=\"font-weight: 400;\">It gives your team a reliable technical partner, rather than leaving the website untouched until something breaks.</span></p>\n"}}]}]]}]}],["$","div","1",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What’s included in SiteCare?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">SiteCare can include website maintenance, CMS and plugin updates, hosting support, uptime monitoring, security checks, speed checks, bug fixes, browser and device fixes, monthly reporting and agreed development hours.</span></p>\n<p><span style=\"font-weight: 400;\">The exact setup depends on your website, platform and support package.</span></p>\n"}}]}]]}]}],["$","div","2",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Can we use SiteCare for website updates and new features?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yes. Each SiteCare package includes a set number of design and development hours per month, which can be used across agreed website updates.</span></p>\n<p><span style=\"font-weight: 400;\">That might include new modules, design tweaks, content updates, small UX improvements, functionality changes or other tasks that help the website keep evolving. Larger pieces of work can be scoped separately if they go beyond the hours included in your package.</span></p>\n"}}]}]]}]}],["$","div","3",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Do we need SiteCare after launch?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yes, if you want your website to keep working properly.</span></p>\n<p><span style=\"font-weight: 400;\">A website is not a one-and-done project. Browsers, plugins, CMS platforms, security requirements and business needs all change over time. SiteCare protects the quality of the website after launch and helps it stay useful as the business moves forward.</span></p>\n"}}]}]]}]}],["$","div","4",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Does SiteCare include hosting?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">It can. SiteCare can include secure, optimised hosting, monitoring and day-to-day support depending on your website and package.</span></p>\n<p><span style=\"font-weight: 400;\">Reliable hosting helps with speed, stability, security and uptime, so it often forms an important part of ongoing website care.</span></p>\n"}}]}]]}]}],["$","div","5",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Does SiteCare include website updates?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yes. SiteCare can include CMS updates, plugin updates, agreed technical updates and ongoing development support.</span></p>\n<p><span style=\"font-weight: 400;\">We handle updates carefully, so your team doesn’t have to worry about breaking the site or missing important maintenance.</span></p>\n"}}]}]]}]}],["$","div","6",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Does SiteCare include SEO?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">SiteCare focuses on technical website health, maintenance and support. It can include performance improvements and technical fixes that support SEO, but deeper SEO strategy, blog content and GEO support sit within a separate add-on package. </span></p>\n"}}]}]]}]}],["$","div","7",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Can you support websites you didn’t build?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Sometimes. We’ll need to review the website first to understand how it has been built, which platform it uses and whether there are existing technical issues.</span></p>\n<p><span style=\"font-weight: 400;\">SiteCare is strongest for websites we’ve designed and developed, but we can advise on whether support is possible for an existing site.</span></p>\n"}}]}]]}]}],["$","div","8",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What happens if something breaks?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">You’ll have a clear route to raise support requests with our dedicated team. We’ll review the issue, prioritise it based on urgency and resolve it within the agreed support process. The goal is to stop small problems becoming bigger problems.</span></p>\n"}}]}]]}]}],["$","div","9",{"className":"FaqsList_faq__k2u7Q","children":["$","$L33",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Will you monitor website speed and uptime?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yes. SiteCare can include uptime monitoring, speed checks and performance recommendations.</span></p>\n<p><span style=\"font-weight: 400;\">If downtime or performance issues appear, we can investigate and respond through the agreed support process. This helps keep the site fast, stable and ready for users.</span></p>\n"}}]}]]}]}]]]}]]}],"$L35","$L36"]}]]
