_lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$1f"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/01/revolut-case-portfolio-instagram-preview.jpeg 1079w, https://kota-content.b-cdn.net/app/uploads/2026/01/revolut-case-portfolio-instagram-preview-500x301.jpeg 500w, https://kota-content.b-cdn.net/app/uploads/2026/01/revolut-case-portfolio-instagram-preview-768x462.jpeg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/01/revolut-case-portfolio-instagram-preview.jpeg","mediaDetails":{"width":1079,"height":649}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p>Source: <a href=\"https://itmonks.com/case-study/revolut/\" target=\"_blank\" rel=\"noopener\">IT Monks</a></p>\n"}}]]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>2. Revolut</h2>\n<p data-start=\"105\" data-end=\"419\"><span class=\"hover:entity-accent entity-underline inline cursor-pointer align-baseline\"><span class=\"whitespace-normal\">Revolut</span></span> set out to feel capable above all else. The brand language makes that position clear. High-contrast colour. Compressed layouts. Assertive typography. Energetic motion. Every choice signals scale, range and momentum. This is a brand built to communicate reach, not reassurance.</p>\n<p data-start=\"421\" data-end=\"705\">That’s because Revolut’s audience isn’t seeking comfort. They want access, flexibility and control across an expanding set of financial tools. The brand presents itself accordingly — confident, sometimes uncompromising, and deliberately unsentimental. Less companion, more instrument.</p>\n<p data-start=\"707\" data-end=\"829\" data-is-last-node=\"\" data-is-only-node=\"\">When identity and utility align this tightly, design stops acting as surface treatment and starts functioning as evidence.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2026/01/1609-new-starling-cards.png 642w, https://kota-content.b-cdn.net/app/uploads/2026/01/1609-new-starling-cards-500x333.png 500w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2026/01/1609-new-starling-cards.png","mediaDetails":{"width":642,"height":428}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p>Source:<a href=\"https://www.starlingbank.com/about/branding-update/\" target=\"_blank\" rel=\"noopener\"> Starling </a></p>\n"}}]]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$20"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"