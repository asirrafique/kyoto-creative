22:["$","section",null,{"className":"Intro_intro__B7xXJ","children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"$undefined","children":["$","$L1a",null,{"children":["$","span",null,{"children":"Captivating motion graphics that turn heads."}]}]}],["$","div",null,{"className":"Intro_text__4DPtt prose","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Wow your audience with seamless motion graphics that bring your brand to life. From subtle flickers of movement to advanced 3D rendering, our expert team can integrate a variety of animated effects into your website without compromising on functionality.</p>\n"}}]}]}]]}]}]
23:["$","section",null,{"className":"TextImageRows_textImageRows__lOU02","children":["$","div",null,{"className":"container","children":[[["$","div","0",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Strategic messaging."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Copywriting starts long before the fingers hit the keyboard. First, we get clear on what your brand stands for, who it needs to reach and what people need to take away. Then we turn that thinking into language with a clear role.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L2f",null,{"fill":true,"children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2023/11/strategic-marketing-V2.mp4","layout":"fill"}]]}]}]]}],["$","div","1",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Website copywriting."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Too many websites are designed first and written later, leaving copy to squeeze into whatever space is left. We do it differently. The words develop alongside the strategy, UX and design, so the whole experience pulls in the same direction.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L2f",null,{"fill":true,"children":[["$","$L21",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/11/website-copywriting.jpg 1224w, https://kota-content.b-cdn.net/app/uploads/2023/11/website-copywriting-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/11/website-copywriting-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/11/website-copywriting.jpg","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","2",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Brand-led messaging."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Your copy should sound like it belongs to your brand, not a competitor with the logo swapped out. We use your positioning, tone of voice and audience insight to create language that feels distinctive, credible and easy to trust.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L2f",null,{"fill":true,"children":[["$","$L21",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/11/brand-led-messaging.jpg 1224w, https://kota-content.b-cdn.net/app/uploads/2023/11/brand-led-messaging-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/11/brand-led-messaging-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/11/brand-led-messaging.jpg","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","3",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"SEO copywriting."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Search visibility comes from being the best answer, not just the most optimised page. We create authoritative, audience-focused content built around genuine expertise, helping brands earn visibility across search engines, AI platforms, and whatever comes next.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L2f",null,{"fill":true,"children":[["$","$L21",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/11/seo-copywriting.jpg 1224w, https://kota-content.b-cdn.net/app/uploads/2023/11/seo-copywriting-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/11/seo-copywriting-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/11/seo-copywriting.jpg","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","4",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Thought leadership and editorial content."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Lead the conversation rather than adding to the noise. As part of our ongoing SEO support, we plan and write content that builds topical authority over time: useful, well-argued and grounded in real expertise.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L2f",null,{"fill":true,"children":[["$","$L21",null,