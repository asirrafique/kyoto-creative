L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h4>Info:</h4>\n<p><a href=\"https://www.peartreecafe.co.uk/pear-tree-cafe-battersea\" target=\"_blank\" rel=\"noopener\">www.peartreecafe.co.uk</a></p>\n<p><iframe loading=\"lazy\" style=\"border: 0;\" src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2484.8284632764626!2d-0.15336088454209737!3d51.479662879630624!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4876050595eea9fb%3A0x92eb238934f035eb!2sPear%20Tree%20Cafe!5e0!3m2!1sen!2suk!4v1627989651776!5m2!1sen!2suk\" width=\"600\" height=\"300\" allowfullscreen=\"allowfullscreen\" data-mce-fragment=\"1\"></iframe></p>\n<p>&nbsp;</p>\n<h2>Putt in the Park.</h2>\n<p>Despite the rainy weather, as seasoned minigolfers, we decided to go ahead with our session. Those of us who were overly optimistic about the weather forecast received stylish waterproof ponchos (for fashion inspiration see pics below). The 12-hole course was challenging and we had a great time &#8211; mini golf is always a good idea for team outings.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"TwoMediaGrid_twoMediaGrid__N4mxT","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TwoMediaGrid_left__e0Ka_","children":["$","$L1a",null,{"children":[["$","figure",null,{"className":"$undefined","data-width":"$undefined","children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0908500300.jpg 1301w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0908500300-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0908500300-768x576.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0908500300.jpg","mediaDetails":{"width":1301,"height":976}},"layout":"intrinsic"}]}],false]}]}],["$","div",null,{"className":"TwoMediaGrid_right__cnLmS","children":["$","$L1a",null,{"delay":0.15,"children":[["$","figure",null,{"className":"$undefined","data-width":"$undefined","children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/putt-in-the-park-1400x933.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/putt-in-the-park-2000x1333.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/putt-in-the-park-500x333.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/putt-in-the-park-768x512.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/putt-in-the-park-1536x1024.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/putt-in-the-park-2048x1365.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/putt-in-the-park.jpg","mediaDetails":{"width":2500,"height":1666}},"layout":"intrinsic"}]}],false]}]}]]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h4>Info:</h4>\n<p><a href=\"https://www.puttinthepark.com/courses/battersea-park/\" target=\"_blank\" rel=\"noopener\">www.puttinthepark.com</a></p>\n<p><iframe loading=\"lazy\" style=\"border: 0;\" src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2485.040849739102!2d-0.16371408454226688!3d51.47576447962988!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4876050b03c20f8f%3A0xc39311ce1ef797d5!2sPutt%20in%20the%20Park!5e0!3m2!1sen!2suk!4v1627990028309!5m2!1sen!2suk\" width=\"600\" height=\"300\" allowfullscreen=\"allowfullscreen\" data-mce-fragment=\"1\"></iframe></p>\n<p>&nbsp;</p>\n<h2>The Lighthouse Pub.</h2>\n<p>We had lunch at the Lighthouse pub near Battersea Park, already tried-and-tested. Good choice of dishes, catering to both meat-eaters and vegans. They have a big garden, luckily covered so we could shelter from the rain!</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0907335250-1400x789.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0907335250-2000x1127.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0907335250-500x282.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0907335250-768x433.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0907335250-1536x866.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0907335250-2048x1154.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0907335250-2560x1443.jpg","mediaDetails":{"width":2560,"height":1443}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"$1f"}}]}]}]}]}],["$","section",null,{"className":"TwoMediaGrid_twoMediaGrid__N4mxT","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TwoMediaGrid_left__e0Ka_","children":["$","$L1a",null,{"children":[["$","figure",null,{"className":"$undefined","data-width":"$undefined","children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0907446000-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-09074