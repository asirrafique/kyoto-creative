027133!3d51.521900379637486!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48761dc20e6f9a4b%3A0xb26dc1b6477b5df7!2sHijingo%20Bingo!5e0!3m2!1sen!2suk!4v1627990295751!5m2!1sen!2suk\" width=\"600\" height=\"300\" allowfullscreen=\"allowfullscreen\" data-mce-fragment=\"1\"></iframe></p>\n<p>&nbsp;</p>\n<h2>Old Street Records Bar.</h2>\n<p>Our last stop was at another client of ours &#8211; <a href=\"https://kota.co.uk/work/records-bars\" target=\"_blank\" rel=\"noopener\">Old Street Records bar</a>. Drinks and live music, what else could you ask for? We couldn’t possibly stop ourselves from demonstrating our *legendary* dance moves. Great way to end the day!</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0908500700-1400x1050.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0908500700-500x375.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0908500700-768x576.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0908500700-1536x1152.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0908500700.jpg 1546w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/1970-01-19-0908500700.jpg","mediaDetails":{"width":1546,"height":1159}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h4>Info:</h4>\n<p><a href=\"https://www.oldstreetrecords.com/\" target=\"_blank\" r