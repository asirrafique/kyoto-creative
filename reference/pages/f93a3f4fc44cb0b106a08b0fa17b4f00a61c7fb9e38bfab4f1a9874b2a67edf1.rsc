dentity."}}],["$","ul",null,{"className":"ProjectCard_tags__XdVcf","children":[[["$","li","Branding",{"children":"Branding"}],["$","li","Web design & development",{"children":"Web design & development"}]],[["$","li","Agencies",{"children":"Agencies"}],["$","li","Retail",{"children":"Retail"}]]]}]]}],["$","$L20",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2025/02/hero-1400x788.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2025/02/hero-2000x1126.webp 2000w, https://kota-content.b-cdn.net/app/uploads/2025/02/hero-500x281.webp 500w, https://kota-content.b-cdn.net/app/uploads/2025/02/hero-768x432.webp 768w, https://kota-content.b-cdn.net/app/uploads/2025/02/hero-1536x865.webp 1536w, https://kota-content.b-cdn.net/app/uploads/2025/02/hero-2048x1153.webp 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2025/02/hero.webp","mediaDetails":{"width":2448,"height":1378}},"layout":"fill"}],["$","video",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/02/isi-vid2-1.mp4","className":"ProjectCard_video__AheFz","autoPlay":true,"muted":true,"loop":true,"preload":"none","playsInline":true}]]}]]}]]}]}],["$","div",null,{"className":"container","children":["$","div",null,{"className":"RelatedProjects_viewAllLinkMobile__pDKQH","children":["$","$L11",null,{"type":"a-internal","text":"View all projects","color":"white","href":"/work"}]}]}]]}],["$","section",null,{"className":"FaqsList_faqsList__W3Ud0","children":[["$","$L10",null,{}],["$","div",null,{"className":"container","children":[["$","div",null,{"className":"FaqsList_heading__kNT8k","children":["$","p",null,{"children":["$","$L2f",null,{"children":"FAQ's"}]}]}],[["$","div","0",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2f",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What’s included in a WordPress and CMS project?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Most projects include CMS strategy, content modelling, page templates, modular components, custom WordPress development, editor tools, integrations, testing and training. Depending on the project, we can also support Sanity CMS, headless CMS development, migration, SEO and ongoing support.</span></p>\n"}}]}]]}]}],["$","div","1",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2f",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What’s the difference between WordPress and Sanity?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">WordPress is a traditional CMS that works well for flexible websites, blogs, landing pages and marketing teams who want a familiar editing experience. It’s often a strong choice when you need a powerful, editor-friendly website.</span></p>\n<p><span style=\"font-weight: 400;\">Sanity CMS can be a better fit for projects that need structured content, flexible publishing workflows or headless architecture. It’s especially useful for websites with complex content models, multiple markets, multiple channels or more advanced digital requirements.</span></p>\n"}}]}]]}]}],["$","div","2",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2f",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"What is a headless CMS?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">A headless CMS separates the content management system from the front-end website. This gives teams more flexibility in how content is delivered across websites, apps and other digital touchpoints, while giving designers and developers more freedom to create distinctive experiences.</span></p>\n"}}]}]]}]}],["$","div","3",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2f",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Do you use page builders?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yes, but carefully. We&#8217;ve created our own modular page-building system that gives teams flexibility without letting the design fall apart. The goal is to make content creation easier while protecting performance, consistency and the quality of the website.</span></p>\n"}}]}]]}]}],["$","div","4",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2f",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Will our team be able to update the website themselves?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Of course. We build CMSs not for developers, but for real marketing teams</span><span style=\"font-weight: 400;\">.</span><span style=\"font-weight: 400;\"> You’ll be able to update agreed content, create pages, manage media and publish new material, with training and documentation provided before launch.</span></p>\n"}}]}]]}]}],["$","div","5",{"className":"FaqsList_faq__k2u7Q","children":["$","$L2f",null,{"children":[["$","label",null,{"className":"FaqsList_question__Dd04C","children":[["$","span",null,{"className":"FaqsList_icon__Jq0d_","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 40 40","children":["$","path",null,{"fill":"#fff","d":"M17.5 40V22.5H0v-5h17.5V0h5v17.5H40v5H22.5V40h-5z"}]}]}],"Can you migrate our existing website to a new CMS?",["$","input",null,{"type":"checkbox"}]]}],["$","div",null,{"className":"FaqsList_answer__xPq_g prose","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Yes. We support CMS migration, including content planning, redirects, SEO considerations, technical setup and quality assurance. The aim is to move your website without losing visibility, structure or important content.</span><br />\n<!-- notionvc: 882b72e4-4856-4f2d-bab2-631453f14e97 --></p>\n"}}]}]]}]}]]]}]]}],"$L31","$L32"]}]]
33:I[9377,["922","static/chunks/c15bf2b0-7fe4609d5aed7ee2.js","6689","static/chunks/b536a0f1-48e07d9a196acd0d.js","210","static/chunks/c6a54c64-52e4c013414e73d2.js","1550","static/chunks/1550-75709fc12a079aa2.js","1242","static/chunks/1242-b8f16838e7608b53.js","6644","static/chunks/6644-79af0604a55e02a8.js","4434","static/chunks/4434-660c906de7f131e6.js","4143","static/chunks/4143-6b83e17252ec01c2.js","988","static/chunks/988-86d1af1c6c90b59b.js","4048","static/chunks/app/service/%5Bslug%5D/page-53d2604786d625db.js"],"default"]
22:["$","section",null,{"className":"Intro_intro__B7xXJ","children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"$undefined","children":["$","$L1a",null,{"children":["$","span",null,{"children":"Give your team the keys."}]}]}],["$","div",null,{"className":"Intro_text__4DPtt prose","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p><span style=\"font-weight: 400;\">Your website should grow with the business, not become a beautiful thing nobody wants to touch. We create CMS platforms that make content easy to manage, pages easy to build and updates easy to make. </span></p>\n"}}]}]}]]}]}]
23:["$","section",null,{"className":"TextImageRows_textImageRows__lOU02","children":["$","div",null,{"className":"container","children":[[["$","div","0",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"CMS strategy."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>The right CMS depends on how your team works. We help define the content structure, editing experience, permissions, page types and integrations your website needs, then build a system that supports the real people managing it.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L33",null,{"fill":true,"children":[["$","$L20",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/11/cms-strategy.jpg 1224w, https://kota-content.b-cdn.net/app/uploads/2023/11/cms-strategy-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/11/cms-strategy-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/11/cms-strategy.jpg","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","1",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"WordPress development."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Custom WordPress websites with flexible editing systems, clean component libraries and enough control for your team to move quickly. No bloated templates. No page builder chaos. Just a CMS that feels practical, scalable and properly built.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L33",null,{"fill":true,"children":[["$","$L20",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/11/wordpress-development2-1.png 1224w, https://kota-content.b-cdn.net/app/uploads/2023/11/wordpress-development2-1-500x500.png 500w, https://kota-content.b-cdn.net/app/uploads/2023/11/wordpress-development2-1-768x768.png 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/11/wordpress-development2-1.png","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","2",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":" Sanity CMS."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>For projects that need more flexibility, we build with Sanity CMS to create structured content systems that are fast, scalable and easy to manage. Ideal for brands with complex content, multiple channels or more advanced publishing needs.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L33",null,{"fill":true,"children":[["$","$L20",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/11/sanity2.jpg 1224w, https://kota-content.b-cdn.net/app/uploads/2023/11/sanity2-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/11/sanity2-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/11/sanity2.jpg","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","3",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Headless CMS."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>Headless CMS gives you more freedom in how content is created, managed and delivered. We design and develop headless websites where the content system and front-end work together beautifully, without tying your brand to a single rigid platform.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L33",null,{"fill":true,"children":[["$","$L20",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/11/headless2.jpg 1224w, https://kota-content.b-cdn.net/app/uploads/2023/11/headless2-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/11/headless2-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/11/headless2.jpg","mediaDetails":{"width":1224,"height":1224}},"layout":"fill"}],false]}]}]]}],["$","div","4",{"className":"TextImageRows_row__PPlpB","children":[["$","div",null,{"className":"TextImageRows_text__bRCSP","children":[["$","h3",null,{"className":"TextImageRows_heading__RS3OS","children":["$","$L1a",null,{"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"Page builders."}}]}]}],["$","div",null,{"className":"TextImageRows_text__bRCSP","children":["$","$L1c",null,{"delay":0.3,"children":["$","span",null,{"dangerouslySetInnerHTML":{"__html":"<p>We create controlled, modular page-building systems that let your team create new pages confidently, while keeping your layouts, components and brand standards intact.</p>\n"}}]}]}],null]}],["$","figure",null,{"className":"TextImageRows_media__twu3R","children":["$","$L33",null,{"fill":true,"children":[["$","$L20",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/11/page-builders-1-1400x1400.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2023/11/page-builders-1-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/11/page-builders-1-768x768.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2023/11/page-builders-1-1536x1536.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2023/11/page-builders-1.jpg 1836w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/11/page-builders-1.jpg","mediaDetails":{"width":1836,"height":1836}},"layout":"fill"}],false]}]}]]}]],false]}]}]
