ota-content.b-cdn.net/app/uploads/2024/02/Header_b-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Header_b-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Header_b-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Header_b-1536x864.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Header_b.jpg 1920w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Header_b.jpg","mediaDetails":{"width":1920,"height":1080}},"layout":"fill","lazy":false}]}]}],false]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__jY2p_","children":[["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Introduction.</h2>\n<p>As 2023 is fast approaching we look at the key design trends that will be making headway in the new year. There’s still a desire for calm and simplicity mixed with comforting moments of nostalgia and with technology continuing to evolve, 3D and animation are at the forefront of design.</p>\n<p>Read about the key trends for 2023 below!</p>\n"}}]}]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>1. Simplicity</h2>\n<p>In the midst of the chaos that is still happening around us, the minimal design trend brings a moment of peace and calm. White space gives the audience room to breathe and absorb essential content easily. A muted colour palette with sometimes hints of earthy tones creates a serene experience.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/tangerine-header-1400x813.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/tangerine-header-2000x1161.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/tangerine-header-500x290.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/tangerine-header-768x446.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/tangerine-header-1536x892.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/tangerine-header-2048x1189.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/tangerine-header.jpg","mediaDetails":{"width":2360,"height":1370}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://tangerine.net/\" target=\"_blank\" rel=\"noopener\">tangerine.net</a></p>\n"}}]]}],false]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Stars_Fades_International_b-1400x750.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Stars_Fades_International_b-2000x1072.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Stars_Fades_International_b-500x268.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Stars_Fades_International_b-768x412.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Stars_Fades_International_b-1536x823.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Stars_Fades_International_b-2048x1098.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Stars_Fades_International_b.jpg","mediaDetails":{"width":2302,"height":1234}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://starfadesinternational.com/\" target=\"_blank\" rel=\"noopener\">starfadesinternational.com</a></p>\n"}}]]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>2. Nostalgia</h2>\n<p>Keeping up with the forever-changing world can leave your head in a bit of a spin. On the other hand, looking back to what we used to know can be comforting and homely. This idea will also be more and more reflected in the design world, with designers opting for what was familiar when creating brand identities and web design. We’ll be drawing inspiration from the 60’s right through to the ’00s to bring that sweetness of nostalgia. Typography and illustration techniques have a key role in bringing this trend together.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study_BMS-1400x750.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study_BMS-2000x1072.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study_BMS-500x268.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study_BMS-768x412.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study_BMS-1536x823.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study_BMS-2048x1098.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Case-Study_BMS.jpg","mediaDetails":{"width":2302,"height":1234}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://bmsperformance.com/\" target=\"_blank\" rel=\"noopener\">bmsperformance.com</a></p>\n"}}]]}],false]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Mr-Beast_2-1400x750.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Mr-Beast_2-2000x1072.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Mr-Beast_2-500x268.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Mr-Beast_2-768x412.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Mr-Beast_2-1536x823.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Mr-Beast_2-2048x1098.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Mr-Beast_2.jpg","mediaDetails":{"width":2302,"height":1234}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://mrbeast.store/\" target=\"_blank\" rel=\"noopener\">mrbeast.store</a></p>\n"}}]]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>3. Futurism</h2>\n<p>As software becomes more and more advanced, the ability to create hyper-real illustrations and animations can create an impactful and memorable user experience. It gives another dimension to websites and adds that ‘wow’ factor. Even a subtle touch of an animated cursor or hover interaction can make the experience a whole lot more interesting and keep the viewer engaged for longer!</p>\n<p>VR is becoming a more popular option too with companies wanting to give their customers an opportunity to shop in augmented reality (ie. <a href=\"https://apps.apple.com/us/app/ikea-place/id1279244498\">IKEA Place app</a>).</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Bounce-1400x813.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Bounce-2000x1161.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/Bounce-500x290.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Bounce-768x446.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Bounce-1536x892.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Bounce-2048x1189.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Bounce.jpg","mediaDetails":{"width":2360,"height":1370}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://www.bouncepingpong.com/\" target=\"_blank\" rel=\"noopener\">bouncepingpong.com</a></p>\n"}}]]}],false]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_