children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>We got creative tuning up the websites for some of the more unusual industries.</p>\n<p>We were approached by a family business, <a href=\"https://www.peterthompsongroup.com/\">Peter Thompson Group</a>, serving fresh meat and poultry from London’s Smithfield Market. We also created a new platform for a leading tissue paper company, <a href=\"https://www.accrol.co.uk/\">Accrol</a>.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/Kota-Team-1-1400x788.webp 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/Kota-Team-1-500x281.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/Kota-Team-1-768x432.webp 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/Kota-Team-1-1536x864.webp 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/Kota-Team-1.webp 1920w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/Kota-Team-1.webp","mediaDetails":{"width":1920,"height":1080}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://kota.co.uk/studio\">We welcomed two new team members and quickly made them feel part of our KOTA tribe.</a></p>\n<p>Alex, the youngest member of KOTA, is our Marketing guru by day and a professional Netflix binge-watcher by night, while Matt is a creative mastermind behind some of our projects – when he’s not playing footie, that is.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>July</h2>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/starcount.webp 1200w, https://kota-content.b-cdn.net/app/uploads/2024/02/starcount-500x293.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/starcount-768x450.webp 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/starcount.webp","mediaDetails":{"width":1200,"height":703}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://www.starcount.com/\">We helped a London-based consultancy make data look better than ever.</a></p>\n<p>We created a new website for Starcount, a leading data consultancy, which specialises in the use of data-driven tools to help companies grow. Founded by Edwina Dunn, inventor of the Tesco Club card, Starcount’s innovative technology uncovers patterns in the vast array of information generated by 1.3 billion online consumers. We built a fast loading new platform to showcase their expertise and services.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"Text_text