ren":[["$","div",null,{"className":"Hero_left__0LdJX","children":[["$","div",null,{"className":"$undefined","children":["$","$L1a",null,{"children":["$","div",null,{"className":"Hero_categoriesInner__G68BO","children":[["$","button","culture",{"className":"Hero_category__qOhtb","children":"Culture"}],["$","button","our-work",{"className":"Hero_category__qOhtb","children":"Our work"}]]}]}]}],["$","h1",null,{"children":["$","$L1a",null,{"delay":0.15,"children":["$","span",null,{"children":"2019! A year in the KOTA studio"}]}]}]]}],["$","div",null,{"className":"Hero_right__AZ10b","children":["$","div",null,{"className":"Hero_author__3asj1","children":[["$","figure",null,{"className":"Hero_authorImage__h9wNd","children":["$","$L1a",null,{"delay":0.3,"fill":true,"children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/01/k-logo.jpg 1080w, https://kota-content.b-cdn.net/app/uploads/2024/01/k-logo-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/01/k-logo-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/01/k-logo.jpg","mediaDetails":{"width":1080,"height":1080}},"layout":"fill","priority":"high","lazy":false}]}]}],["$","p",null,{"className":"Hero_date__30zpk","children":["$","$L1a",null,{"delay":0.3,"children":["$","span",null,{"children":"January 8th 2020"}]}]}],["$","p",null,{"className":"Hero_name__eLY42","children":["$","$L1a",null,{"delay":0.3,"children":["$","span",null,{"children":["By ","KOTA"]}]}]}]]}]}],["$","figure",null,{"className":"Hero_image__1mu0E","children":["$","$L1c",null,{"fill":true,"delay":0.45,"children":["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/bottom-right-1.webp 1288w, https://kota-content.b-cdn.net/app/uploads/2024/02/bottom-right-1-500x338.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/bottom-right-1-768x519.webp 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/bottom-right-1.webp","mediaDetails":{"width":1288,"height":870}},"layout":"fill","lazy":false}]}]}],false]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__jY2p_","children":[["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>It’s been a fantastic 2019 for KOTA, having launched a number of successful brands and projects. We also moved into our shiny new office in Clerkenwell and celebrated our 5 year anniversary with trips to <a href=\"https://kota.co.uk/kulture/6-years-kota-interview-ed-design-director?utm_source=december&amp;utm_medium=mailchimp&amp;utm_campaign=newsletter\">Chicago</a> and <a href=\"https://kota.co.uk/kulture/team-trip-amsterdam-thoughts-tips?utm_source=december&amp;utm_medium=mailchimp&amp;utm_campaign=newsletter\">Amsterdam</a>. KOTA got a total of NINE (!) awards this year as well!</p>\n<p>Check out the month by month breakdown of 2019 happenings below.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>January</h2>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/simmons.webp 1200w, https://kota-content.b-cdn.net/app/uploads/2024/02/simmons-500x293.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/simmons-768x450.webp 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/simmons.webp","mediaDetails":{"width":1200,"height":703}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://kota.co.uk/work/simmons-bars\">We expertly crafted a new online presence for this vibrant bar group.</a></p>\n<p>We were tasked with translating the fun, kitsch look and atmosphere of the Simmons Bars venues into a new online platform. Featuring the retro items found within the interiors while remaining simple to navigate. Our signature cut-out montage style was requested especially by the client to bring their brand to life.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/comptoir-libanais.webp 1200w, https://kota-content.b-cdn.net/app/uploads/2024/02/comptoir-libanais-500x293.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/comptoir-libanais-768x450.webp 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/comptoir-libanais.webp","mediaDetails":{"width":1200,"height":703}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://kota.co.uk/work/comptoir-libanais\">We crafted this beautiful looking site for a popular Lebanese restaurant chain.</a></p>\n<p>We brought the vibrant aesthetic of Comptoir Libanais restaurant group through into the website design, really capturing the essence of the brand and atmosphere of the venues online.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>February</h2>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[["$","figure",null,{"className":"FullWidthMedia_image__yCr3O","data-width":"contained","children":[["$","$L1b",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/lightbox.webp 1200w, https://kota-content.b-cdn.net/app/uploads/2024/02/lightbox-500x293.webp 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/lightbox-768x450.webp 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/lightbox.webp","mediaDetails":{"width":1200,"height":703}},"layout":"intrinsic"}],null]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://kota.co.uk/work/lightbox\">We got this film production company ready for their Oscar nomination with a brand new digital look.</a></p>\n<p>Lightbox challenged Kota to deliver them the best website of the film production industry, a task we tackled with plenty of creative flair.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWid