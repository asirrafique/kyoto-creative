x1440.jpg","mediaDetails":{"width":2880,"height":1620}},"layout":"intrinsic"}],["$","figcaption",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://kota.co.uk/work/upp/\" target=\"_blank\" rel=\"noopener\">UPP by KOTA</a></p>\n"}}]]}],false]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"Text_textInner__lCgQa","children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>There were moments when it would have been much easier to simplify it. Make it more “normal”. Pull it back toward what that sector already expects. What stopped it collapsing was strategy.</p>\n<p>UPP didn’t want to look like another VFX supplier. They wanted to be perceived as a world-builder. A studio that doesn’t just execute shots, but creates cinematic environments from nothing. Once that positioning was locked, the weird idea stopped being optional. It became necessary.</p>\n<p>The execution followed the intent instead of diluting it.</p>\n<p>Now, the site doesn’t just show their work. It <em>behaves</em> like it.</p>\n<p>That’s the moment when weird stops feeling indulgent and starts feeling inevitable.</p>\n"}}]}]}]}]}],["$","section",null,{"className":"FullWidthMedia_fullWidthMedia__NRjkh","children":["$","$L1c",null,{"children":["$","div",null,{"className":"container","children":[false,["$","div",null,{"className":"FullWidthMedia_video__krg5m","data-width":"contained","children":[["$","$L1f",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2025/04/times-1.mp4","layout":"intrinsic"}],["$","div",null,{"className":"FullWidthMedia_caption__QeGJx","dangerouslySetInnerHTML":{"__html":"<p><a href=\"https://kota.co.uk/work/upp/\" target=\"_blank\" rel=\"noopener\">UPP by KOTA</a></p>\n"}}]]}]]}]}]}],["$","section",null,{"className":"Text_text__jOaGN","children":["$","$L1d",null,