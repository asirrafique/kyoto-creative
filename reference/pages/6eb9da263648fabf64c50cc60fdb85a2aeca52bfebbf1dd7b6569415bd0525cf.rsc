","children":[["$","div","dGVybToxMw==",{"className":"Hero_service__YURmU","children":"Digital Marketing"}]]}]}]}],["$","div",null,{"className":"Hero_arrow__KkhoQ","children":["$","$L1e",null,{"delay":0.9,"children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"0 0 75.91 75.65","children":["$","path",null,{"d":"m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z"}]}]}]}]]}]]}]}],["$","section",null,{"className":"Bento_bento__pskN5","children":[false,false,["$","div",null,{"className":"container","children":["$","div",null,{"className":"Bento_contained__4KAWy","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5b-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5b-2000x1125.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5b-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5b-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5b-1536x864.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5b-2048x1152.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5b.jpg","mediaDetails":{"width":2560,"height":1440}},"lazy":false,"priority":"high","sizes":"100vw"}],false]}]}]]}],["$","section",null,{"className":"Intro_intro__kvY3Y","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Intro_text__1JkoM","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>After winning an extremely in-depth pitch process, we were selected by Jamie Oliver to produce the digital marketing campaign for his ‘5 Ingredients’ publication. The book centres on the concept of using just five main ingredients for each dish and has a very stripped back, minimal aesthetic.</p>\n<p>Our main concepts for the campaign were also based on the idea of simplicity. The creative for the out of home advertising played with the idea of deconstructing the dishes, showing the 5 ingredients in their original form, next to a half plate of the finished meal. The book went on to become the biggest selling publication in the UK in 2017 and so far has had two television series made from it.</p>\n"}}]}]}],["$","div",null,{"className":"Intro_projectDetails__UWcsm","children":[["$","div",null,{"className":"Intro_left__d8bha","children":["$","$L1d",null,{"delay":0.15,"children":[["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Industry"}],["$","p",null,{"children":"Publishing"}]]}],["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Location"}],["$","p",null,{"children":"International"}]]}]]}]}],["$","div",null,{"className":"Intro_right__E3UWy","children":["$","$L1d",null,{"delay":0.15,"children":null}]}]]}],["$","div",null,{"className":"Intro_link__Wrq2r","children":null}]]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__FAKQG","children":[["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L1f",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5c-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5c-2000x1125.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5c-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5c-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5c-1536x864.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5c-2048x1152.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5c.jpg","mediaDetails":{"width":2560,"height":1440}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5d-1400x1400.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5d-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5d-768x768.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5d.jpg 1440w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5d.jpg","mediaDetails":{"width":1440,"height":1440}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[false,["$","$L20",null,{"src":"https://kota-content.b-cdn.net/app/uploads/2024/03/jamie-numbers.mp4","layout":"intrinsic"}]]}],false,false]}]}]}]}],["$","section",null,{"className":"SingleImage_singleImage__NY3zv","data-margin":"default","children":["$","$L21",null,{"children":[false,["$","div",null,{"className":"SingleImage_fullWidthImage__nPNe8","children":["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5a-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5a-2000x1125.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5a-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5a-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5a-1536x864.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5a-2048x1152.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/03/jamie5a.jpg","mediaDetails":{"width":2560,"height":1440}}}]}]]}]}],["$","section",null,{"className":"TextLeftListRight_textLef