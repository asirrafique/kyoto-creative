https://kota-content.b-cdn.net/app/uploads/2023/10/15-768x768.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/10/15.jpg","mediaDetails":{"width":1188,"height":1188}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media5__PFPPK","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/10/14.jpg 1190w, https://kota-content.b-cdn.net/app/uploads/2023/10/14-500x500.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/10/14-768x767.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/10/14.jpg","mediaDetails":{"width":1190,"height":1188}},"layout":"intrinsic"}],false]}]]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Digital Marketing.</h2>\n<p>Alongside the brand and website, we also guided Wogan&#8217;s digital marketing strategy to grow the DTC side of the business. Based on the knowledge we had about the business, we helped them establish the target audiences and position the brand accordingly amongst competitors, as well as researched opportunities for each digital marketing channel.</p>\n<p>We suggested &#8216;Coffee that doesn&#8217;t cost the Earth&#8217; as the guiding motto, highlighting their commitment to sustainability and fair pricing for both customers and farmers. To re-introduce the new Wogan we created a dynamic video showcasing the company, the family and their values.</p>\n<p>Wogan also wanted us to support their digital marketing with our strategy and design expertise to help grow their brand awareness. We manage their socials, email marketing, SEO, and Google Ads. Check out their Insta at <a href=\"https://www.instagram.com/wogancoffee/\">@wogancoffee</a>.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"$undefined","data-margin":"default","children":[["$","div",null,{"className":"container","children":["$","div",null,{"className":"SingleImage_containedImage__N2jLD","children":["$","$L22",null,{"data":{"__typename":"Project_Singleproject_ContentBuilder_SingleVideo","fieldGroupName":"Project_Singleproject_ContentBuilder_SingleVideo","alignment":"contained","marginBottom":"default","loop":{"mediaItemUrl":"https://kota-content.b-cdn.net/app/uploads/2023/10/wogan-video-compressed.mp4"},"fullVideo":null}}]}]}],false]}],["$","section",null,{"className":"$undefined","data-margin":"default","children":[["$","div",null,{"className":"container","children":["$","div",null,{"className":"SingleImage_containedImage__N2jLD","children":["$","$L22",null,{"data":{"__typename":"Project_Singleproject_ContentBuilder_SingleVideo","fieldGroupName":"Project_Singleproject_ContentBuilder_SingleVideo","alignment":"contained","marginBottom":"default","loop":{"mediaItemUrl":"https://kota-content.b-cdn.net/app/uploads/2023/10/wogan-social-compressed.mp4"},"fullVideo":null}}]}]}],false]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L1f",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":null,"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":null,"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[[