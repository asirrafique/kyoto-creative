uploads/2023/10/04-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2023/10/04-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/10/04.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media4__biNHW","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/10/06-1400x786.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2023/10/06-2000x1123.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2023/10/06-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/10/06-768x431.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2023/10/06-1536x862.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2023/10/06-2048x1149.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/10/06.jpg","mediaDetails":{"width":2448,"height":1374}},"layout":"intrinsic"}],false]}],false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1d",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Website.</h2>\n<p>The new website engages users with the brand story and also simplifies the navigation around their wide selection of coffee. The UX had to be split between B2B customers interested in white label or bulk orders for cafes and shops, and B2C for consumers wanting their daily coffee fix.</p>\n<p>We also wanted to highlight Wogan&#8217;s flexible subscription offer and entice users to easily sign up for the service, whether via the subscription page or directly from product pages. We also created a coffee quiz which allows users to easily tailor their coffee deliveries based on personal tastes.</p>\n<p>Navigating the world of specialty coffee can be tricky, so we also created a coffee guide functionality as a part of their content hub, alongside the blog.</p>\n<p>&nbsp;</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L1f",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout1__6P6Mg","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/10/07-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2023/10/07-2000x1126.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2023/10/07-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2023/10/07-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2023/10/07-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2023/10/07-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/10/07.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2023/10/woganimage.jpg 1190w, https://kota-content.b-cdn.net/app/uploads/2023/10/woganimage-432x500.jpg 432w, https://kota-content.b-cdn.net/app/uploads/2023/10/woganimage-768x889.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2023/10/woganimage.jpg","mediaDetails":{"width":1190,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1c",null,{"image":{"altText":"","srcSet":"https://kota-c