https://kota-content.b-cdn.net/app/uploads/2024/02/1-3-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/1-3.jpg","mediaDetails":{"width":2448,"height":1378}},"lazy":false,"priority":"high","sizes":"100vw"}],false]}]}]]}],["$","section",null,{"className":"Intro_intro__kvY3Y","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"Intro_text__1JkoM","children":["$","$L1c",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>PixelArtworks is a global pioneer in pixel and light technology. They create awe-inspiring, immersive experiences for clients looking to build deep, long-lasting connections with people.</p>\n<p>They approached us in early 2023, looking for an agency to completely redesign their website. Turns out, this came after them seeing the site we created for Bounce, which also happens to be one of their clients (small world).</p>\n<p>Their company is made up of designers, animators, technologists and production managers who all come together to deliver seamless experiences. As they are an innovative Creative Technology company, their new website needed to feel as futuristic as it did imaginative, calling for the latest web technologies.</p>\n"}}]}]}],["$","div",null,{"className":"Intro_projectDetails__UWcsm","children":[["$","div",null,{"className":"Intro_left__d8bha","children":["$","$L1c",null,{"delay":0.15,"children":[["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Industry"}],["$","p",null,{"children":"Retail & Advertising"}]]}],["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Location"}],["$","p",null,{"children":"London, UK"}]]}]]}]}],["$","div",null,{"className":"Intro_right__E3UWy","children":["$","$L1c",null,{"delay":0.15,"children":["$","div",null,{"className":"$undefined","children":[["$","p",null,{"className":"Intro_smallHeading__gYXTn","children":"Featured by"}],["$","div",null,{"className":"Intro_list__65yay","children":[["$","a","0",{"href":"https://www.awwwards.com/sites/pixelartworks","target":"_blank","children":"Awwwards"}],["$","a","1",{"href":"https://orpetron.com/sites/pixelartworks/","target":"_blank","children":"Orpetron"}]]}]]}]}]}]]}],["$","div",null,{"className":"Intro_link__Wrq2r","children":null}]]}]}],["$","section",null,{"className":"ContentBuilder_contentBuilder__FAKQG","children":[["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L1f",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout6__wJx6J","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1e",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/2-7-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/2-7-2000x1126.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/2-7-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/2-7-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/2-7-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/2-7-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/2-7.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1e",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/3-4.jpg 1190w, https://kota-content.b-cdn.net/app/uploads/2024/02/3-4-432x500.jpg 432w, https://kota-content.b-cdn.net/app/uploads/2024/02/3-4-768x889.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/3-4.jpg","mediaDetails":{"width":1190,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media3__rEmNG","data-animation":"grid-item","children":[["$","$L1e",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/4-4.jpg 1188w, https://kota-content.b-cdn.net/app/uploads/2024/02/4-4-431x500.jpg 431w, https://kota-content.b-cdn.net/app/uploads/2024/02/4-4-768x891.jpg 768w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/4-4.jpg","mediaDetails":{"width":1188,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media4__biNHW","data-animation":"grid-item","children":[["$","$L1e",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/5-1-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-1-2000x1126.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-1-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-1-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-1-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/5-1-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/5-1.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],false]}]}]}]}],["$","section",null,{"className":"TextLeftListRight_textLeftListRight__i5dfy","data-margin":"default","data-right-empty":"true","style":{"--brand-color":"red"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"TextLeftListRight_left__fjEbB","children":["$","$L1c",null,{"children":["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<h2>Design.</h2>\n<p>Our goal was to design a new website that not only positions PixelArtworks as a leader in immersive experiences, but also functions as a sales generation tool. We achieved this through our extensive research and design discovery phase, finding the sweet spot between modern user interface trends and a focused user experience.</p>\n<p>We were lucky enough to have great brand guidelines and an extensive library of visual assets to use. We knew immediately that the white shards (which represent light) would be great for interactions within the new site. We animated them in After Effects and using Lottie we were able to create a bank of page, image and menu transitions. Doing these types of animations via code would usually take a developer days, but they can be done in just a few hours by a designer. They are also extremely well optimised for the web.</p>\n"}}]}]}],null]}]}],["$","section",null,{"className":"MediaGallery_mediaGallery__vB7wJ ","data-margin":"default","style":{"backgroundColor":"transparent"},"children":["$","$L1f",null,{"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"MediaGallery_grid___30fo MediaGallery_layout6__wJx6J","children":[["$","div",null,{"className":"MediaGallery_media1__9Ryxs","data-animation":"grid-item","children":[["$","$L1e",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/6-1-1400x788.jpg 1400w, https://kota-content.b-cdn.net/app/uploads/2024/02/6-1-2000x1126.jpg 2000w, https://kota-content.b-cdn.net/app/uploads/2024/02/6-1-500x281.jpg 500w, https://kota-content.b-cdn.net/app/uploads/2024/02/6-1-768x432.jpg 768w, https://kota-content.b-cdn.net/app/uploads/2024/02/6-1-1536x865.jpg 1536w, https://kota-content.b-cdn.net/app/uploads/2024/02/6-1-2048x1153.jpg 2048w","sourceUrl":"https://kota-content.b-cdn.net/app/uploads/2024/02/6-1.jpg","mediaDetails":{"width":2448,"height":1378}},"layout":"intrinsic"}],false]}],["$","div",null,{"className":"MediaGallery_media2__Uc1vY","data-animation":"grid-item","children":[["$","$L1e",null,{"image":{"altText":"","srcSet":"https://kota-content.b-cdn.net/app/uploads/2024/02/7-2.jpg 1190w, https://kota-content.b-cdn.net/app/